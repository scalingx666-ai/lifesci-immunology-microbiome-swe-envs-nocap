+def test_the_estimate_scales_with_the_cloud():
+    a, _ = estimate_error_rate(*cloud(10, 20, 100_000))
+    b, _ = estimate_error_rate(*cloud(10, 40, 100_000))
+    assert b == pytest.approx(2 * a)
