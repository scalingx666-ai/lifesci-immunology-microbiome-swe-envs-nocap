+                        file("$outputDir/bbduk/2612_ERR5766176_B.bbduk.log").getName() + " contains string 'Bases Processed:        133m': " + file("$outputDir/bbduk/2612_ERR5766176_B.bbduk.log").text.contains("Bases Processed:        133m"),
