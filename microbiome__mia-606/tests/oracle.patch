+
+#' @rdname convert
+#' @export
+setMethod(
+    "convertToBIOM", signature = c(x = "SummarizedExperiment"),
+        function(x, assay.type = "counts", ...){
+    ############################## Input check #############################
+    .require_package("biomformat")
+    .check_assay_present(assay.type, x)
+    ############################ Input check end ###########################
