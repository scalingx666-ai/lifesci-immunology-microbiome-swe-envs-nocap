+#' @rdname convert
+#'
+#' @param x \code{\link[TreeSummarizedExperiment:TreeSummarizedExperiment-class]{TreeSummarizedExperiment}}
+#' 
+#' @param assay.type \code{Character scaler}. The name of assay.
