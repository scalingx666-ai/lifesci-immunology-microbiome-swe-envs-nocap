+  refit <- emuFit(Y = Y, X = X, B = fit$B, refit = FALSE, estimates_only = TRUE)
+  expect_lt(max(abs(refit$Y_augmented - fit$Y_augmented)), 1e-10)
+  expect_lt(max(abs(refit$z_hat - fit$z_hat)), 1e-10)
+})
