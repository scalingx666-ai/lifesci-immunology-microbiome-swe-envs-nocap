index 395cb1c21..5672a1cfd 100755
--- a/lib/WorkflowCommons.groovy
+++ b/lib/WorkflowCommons.groovy
@@ -91,6 +91,17 @@ class WorkflowCommons {
         return vals
     }
 
+    //
+    // Function that returns the number of lines in a file
+    //
+    public static Integer getNumLinesInFile(input_file) {
+        def num_lines = 0
+        input_file.eachLine { line ->
+            num_lines ++
+        }
+        return num_lines
+    }
