+    for (auto _ : state) {
+        sdsl::bit_vector mask(boss.num_edges() + 1, false);
+        uint64_t count = boss.mark_sink_dummy_edges(&mask);
+        benchmark::DoNotOptimize(count);
+        benchmark::ClobberMemory();
+    }
+}
