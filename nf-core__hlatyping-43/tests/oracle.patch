-    includeConfig 'conf/aws.config'
-    includeConfig 'conf/igenomes.config'
-  }
-  cfc {
-    includeConfig 'conf/cfc.config'
-  }
-  full_trace {
-    includeConfig 'conf/full_trace.config'
-  }
-  test {
-    includeConfig 'conf/base.config'
-    includeConfig 'conf/test.config'
-  }
-  test_fastq {
-    includeConfig 'conf/base.config'
