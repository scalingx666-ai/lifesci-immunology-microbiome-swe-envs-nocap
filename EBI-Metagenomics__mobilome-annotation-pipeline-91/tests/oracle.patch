+    def test_overlap_below_threshold_not_assigned(self):
+        # protein length 101, overlap = 10 → fraction ~0.10 < 0.90
+        prots = {"prot1": ("ctg1", 100, 200)}
+        mges = {"ctg1": [(191, 300, "IS3")]}
+        result = assign_mge_types(prots, mges)
