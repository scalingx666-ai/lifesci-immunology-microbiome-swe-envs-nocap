+        # protein 100-200 (length 101), mge 109-300 → overlap 100-200 = 92 → 92/101 = 0.91
+        prots = {"prot1": ("ctg1", 100, 200)}
+        mges = {"ctg1": [(109, 300, "IS3")]}
+        result = assign_mge_types(prots, mges)
