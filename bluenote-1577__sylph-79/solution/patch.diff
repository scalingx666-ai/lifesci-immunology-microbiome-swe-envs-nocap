+    fn gsketch(name: &str, kmers: Vec<u64>, pt: Option<Vec<u64>>) -> GenomeSketch {
+        GenomeSketch {
+            genome_kmers: kmers,
+            pseudotax_tracked_nonused_kmers: pt,
+            file_name: name.to_string(),
+            first_contig_name: format!("{}_c1", name),
+            c: 50,
+            k: 31,
+            gn_size: 12345,
+            min_spacing: 30,
+        }
+    }
