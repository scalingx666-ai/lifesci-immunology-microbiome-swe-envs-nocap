+// lanes moved up by N, zeros into the lowest N lanes
+template <int N>
+static inline simd_float simdf32_shiftl_lanes(const simd_float a) {
+#if defined(AVX512)
+    return _mm512_castsi512_ps(_mm512_alignr_epi32(_mm512_castps_si512(a), _mm512_setzero_si512(), 16 - N));
+#elif defined(MMSEQS_AVX512VL_MASKS)
+    return _mm256_castsi256_ps(_mm256_alignr_epi32(_mm256_castps_si256(a), _mm256_setzero_si256(), 8 - N));
+#else
+    return simdi_i2fcast(simdi8_shiftl(simdf_f2icast(a), 4 * N));
+#endif
+}
