+// lanes holding whole numbers in [0, 127] as VECSIZE_FLOAT bytes
+static inline void simdf32_storeu_u8(uint8_t *dst, const simd_float a) {
+#if defined(AVX512)
+    _mm_storeu_si128((__m128i *)dst, _mm512_cvtepi32_epi8(_mm512_cvttps_epi32(a)));
+#elif defined(MMSEQS_AVX512VL_MASKS)
+    _mm_storel_epi64((__m128i *)dst, _mm256_cvtepi32_epi8(_mm256_cvttps_epi32(a)));
+#elif defined(AVX2)
+    const __m256i w = _mm256_cvttps_epi32(a);
+    const __m128i h = _mm_packs_epi32(_mm256_castsi256_si128(w), _mm256_extracti128_si256(w, 1));
+    _mm_storel_epi64((__m128i *)dst, _mm_packus_epi16(h, h));
+#else
+    const __m128i w = _mm_cvttps_epi32(a);
+    const __m128i h = _mm_packs_epi32(w, w);
+    const int32_t b = _mm_cvtsi128_si32(_mm_packus_epi16(h, h));
+    memcpy(dst, &b, sizeof(b));
+#endif
+}
+
+// sum of the lanes in double and in lane order
+static inline double simdf32_hadd_double(const simd_float a) {
+    float t[VECSIZE_FLOAT];
+    simdf32_storeu(t, a);
+    double s = 0;
+    for (int k = 0; k < VECSIZE_FLOAT; ++k) {
+        s += t[k];
+    }
+    return s;
+}
+
+// keeps a product from being fused with a following addition (x86 only)
+static inline simd_float simdf32_no_contract(simd_float a) {
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+    __asm__("" : "+v"(a));
+#endif
+    return a;
+}
