+                        tR: [thisSectionMaxX, ty],
+                        bL: [prevSectionMaxX, by],
+                        bR: [thisSectionMaxX, by],
+                    };
+                    scope._addTriangleCoords(coords, corners, sectionColor);
+                    prevSectionMaxX = thisSectionMaxX;
                 }
             }
-        }
