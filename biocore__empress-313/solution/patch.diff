-                var prevSectionMaxX = prevLayerMaxX;
-                for (var v = 0; v < sortedUniqueValues.length; v++) {
-                    var smVal = sortedUniqueValues[v];
-                    var ct = spi[smVal];
-                    if (ct > 0) {
-                        var sectionColor = sm2color[smVal];
