+                        nids.append(int(n["id"]))
+            if len(nids) == 2:
+                n0 = ag.nodeid2obj[nids[0]]
+                n1 = ag.nodeid2obj[nids[1]]
+                if "length" in n0.data and "length" in n1.data:
+                    # try to put longest node on x-axis
+                    if n0.data["length"] >= n1.data["length"]:
+                        nx = n0
+                        ny = n1
+                    else:
