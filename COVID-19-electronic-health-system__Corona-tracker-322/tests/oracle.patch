+  return {
+    type: SELECT_DATE,
+    date: selectedDate,
+  };
+}
diff --git a/client/src/redux/reducers/calendar.js b/client/src/redux/reducers/calendar.js
new file mode 100644
index 00000000..418fb084
--- /dev/null
+++ b/client/src/redux/reducers/calendar.js
@@ -0,0 +1,19 @@
+import { SELECT_DATE } from '../actions/calendar';
+
+const initialState = {
+  date: [],
+};
+
+const calendarReducer = (state = initialState, action) => {
+  switch (action.type) {
+    case SELECT_DATE:
+      return {
+        ...state,
+        date: action.date,
+      };
+    default:
+      return state;
+  }
+};
+
+export default calendarReducer;
