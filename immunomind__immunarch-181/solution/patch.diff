+
+.as_tsv <- function(.delim_file) {
+  df <- readr::read_tsv(.delim_file, comment = "#")
+  if (ncol(df) == 1) {
+    # treat file as csv and convert it to temporary tsv
+    df <- readr::read_delim(.delim_file, comment = "#")
+    tsv_file <- tempfile()
+    readr::write_tsv(df, tsv_file)
+    return(tsv_file)
+  } else {
+    return(.delim_file)
+  }
+}
