-            allzero = mapreduce(x -> polymap[f(x)...] == 0, &, idx)
-            if allzero
-                for x in idx; newpoly[f(x)...] = k + 1; end
-                k += 1
-            else
-                nz = filter(x -> polymap[f(x)...]!= 0, idx)
-                if length(nz) == 1
-                    for x in idx; newpoly[f(x)...] = polymap[overlap[1]]; end
-                else
