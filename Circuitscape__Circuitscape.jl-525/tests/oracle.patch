+    @test raw_cum[3, 3] == 0 && raw_volt[3, 3] == 0
+
+    # log_transform_maps: log10 of the sum, not the sum of the logs, and
+    # cells with no current in a single pair are nodata only in that pair
+    logt(m) = map(x -> x > 0 ? log10(x) : -9999.0, m)
