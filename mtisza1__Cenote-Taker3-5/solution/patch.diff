+                
+                #with this logic, only files with results (lines starting with >) append the df
+                if line.startswith('>'):
+                    full_desc = line.rstrip('\n').strip('>')
+
+                    ## CDD models
+                    if line.startswith('>cd') or line.startswith('>sd'):
+                        accession = full_desc.split(' ')[0]
+
+                        try:
