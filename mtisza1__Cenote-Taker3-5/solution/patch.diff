+                                annotation = annotationpd.split(';')[0]
+                        except:
+                            annotation = 'hypothetical protein'
+
+                    full_stats = next(hrh, '').strip()
+                    probability = full_stats.split('  ')[0].split('=')[1]
+                    evalue = full_stats.split('  ')[1].split('=')[1]
+                    Aligned_cols = full_stats.split('  ')[3].split('=')[1]
