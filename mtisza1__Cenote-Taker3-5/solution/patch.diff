+
+                    ## PFAM models
+                    elif line.startswith('>PF'):
+                        accession = full_desc.split(' ; ')[0]
+
+                        try:
+                            annotation = full_desc.split('; ')[2]
+                        except:
+                            annotation = 'hypothetical protein'
+
+                    ## PDB models
+                    else:
+                        accession = full_desc.split(' ')[0]
+
