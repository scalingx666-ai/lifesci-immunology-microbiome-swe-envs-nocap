+real_t ComputeSubstanceAmount(const real_t* concentration_array, size_t size,
+                              real_t box_length) {
+  const real_t volume = box_length * box_length * box_length;
+  real_t sum{0};
+  for (size_t i = 0; i < size; i++) {
+    sum += concentration_array[i];
+  }
+  return sum * volume;
+}
