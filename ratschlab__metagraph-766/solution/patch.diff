diff --git a/.github/workflows/main.yml b/.github/workflows/main.yml
index 2698cefb25..cfa886e45c 100644
--- a/.github/workflows/main.yml
+++ b/.github/workflows/main.yml
@@ -178,17 +178,43 @@ jobs:
           cache-from: type=gha
           cache-to: type=gha,mode=max
 
+      # Every pushed image gets its commit's tag. A run that finishes after a newer commit's
+      # run must not move `master` back to its older image, so `master` moves only after the
+      # push, and only while the commit is still the head of the branch.
+      - name: Tags to push
+        id: meta_push
+        if: github.event_name != 'pull_request'
+        uses: docker/metadata-action@v5
+        with:
+          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
+          tags: |
+            type=ref,event=tag
+            type=sha,format=long
+
       - name: Build and push Docker image
         if: github.event_name != 'pull_request'
         uses: docker/build-push-action@v6
         with:
           context: .
           push: true
-          tags: ${{ steps.meta.outputs.tags }}
-          labels: ${{ steps.meta.outputs.labels }}
+          tags: ${{ steps.meta_push.outputs.tags }}
+          labels: ${{ steps.meta_push.outputs.labels }}
           cache-from: type=gha
           cache-to: type=gha,mode=max
 
+      - name: Move the branch tag to this image if the commit is still the branch head
+        if: github.event_name != 'pull_request' && github.ref_type == 'branch'
+        run: |
+          set -euo pipefail
+          remote=$(git ls-remote origin "$GITHUB_REF")
+          head=${remote%%[[:space:]]*}
+          image=${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
+          if [ "$head" = "$GITHUB_SHA" ]; then
+            docker buildx imagetools create -t "$image:$GITHUB_REF_NAME" "$image:sha-$GITHUB_SHA"
+          else
+            echo "Branch head is $head, not $GITHUB_SHA: $image:$GITHUB_REF_NAME stays"
+          fi
+
   # ========================================================================
   # Release
   # ========================================================================
