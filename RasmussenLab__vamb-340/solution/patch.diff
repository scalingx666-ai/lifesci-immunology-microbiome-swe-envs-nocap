+
+    return result
+
+
+# DBScan within the subset of contigs that are annotated with a single genus
+def dbscan_genus(
+    latent_of_genus: np.ndarray,
+    original_indices: np.ndarray,
+    contiglengths_of_genus: np.ndarray,
+    markers: Markers,
