+def _first_present_number(meta, keys):
+    """Return the first numeric metadata value found for any key."""
+    for key in keys:
+        val = meta.get(key)
+        if val is None or val == '':
+            continue
+        try:
+            return float(val)
+        except (TypeError, ValueError):
+            continue
+    return None
+
