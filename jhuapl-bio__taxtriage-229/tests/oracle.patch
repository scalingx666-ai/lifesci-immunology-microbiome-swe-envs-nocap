+def collect_run_highlights(samples_dict, args):
+    """Compute run-level metrics for the cover-page Run Highlights cards."""
+    per_sample_meta = getattr(args, '_input_metadata', {}) or {}
+    sample_min_conf = getattr(args, '_sample_min_conf', {}) or {}
+
+    total_reads = 0.0
+    aligned_reads = 0.0
+    unique_taxids = set()
+    unique_genera = set()
+    high_cons_taxids = set()
+
+    for sample_name, species_groups in samples_dict.items():
+        meta = per_sample_meta.get(sample_name, {}) or {}
+
+        # Total Reads Analyzed = sum(total_reads) across all samples.
+        sample_total = _first_present_number(meta, ['total_reads', 'reads_total'])
+        if sample_total is None:
+            sample_total = sum(float(sg.get('numreads', 0) or 0) for sg in species_groups)
+        total_reads += sample_total
+
+        # % Reads Classified = sum(aligned_reads) / sum(total_reads).
+        # Do NOT use total_organism_reads here.
+        sample_aligned = _first_present_number(meta, ['aligned_reads'])
+        if sample_aligned is None:
+            sample_aligned = sum(float(sg.get('numreads', 0) or 0) for sg in species_groups)
+        aligned_reads += sample_aligned
+
+        min_conf = sample_min_conf.get(sample_name, _DEFAULT_CONF)
+
+        for sg in species_groups:
+            # Count genus-like groups from the top-level organism grouping.
+            genus_key = str(sg.get('toplevelkey', sg.get('key', '')) or '').strip()
+            genus_name = str(sg.get('toplevelname', sg.get('name', '')) or '').strip()
+            if genus_key:
+                unique_genera.add(genus_key)
+            elif genus_name:
+                unique_genera.add(genus_name.lower())
+
+            for strain in get_all_strains(sg):
+                if not has_min_reads(strain, getattr(args, 'min_reads', 1)):
+                    continue
+
+                taxid = str(strain.get('key', '') or '').strip()
+                if taxid:
+                    unique_taxids.add(taxid)
+
+                tax = strain.get('taxonomy') or sg.get('taxonomy') or {}
+                genus = str(tax.get('genus', '') or '').strip()
+                if genus:
+                    unique_genera.add(genus.lower())
+
+                if strain.get('high_cons', False):
+                    passes = strain_passes_with_subkey_promotion(strain, sg, min_conf)
+                    if passes and taxid:
+                        high_cons_taxids.add(taxid)
+
+    classified_pct = (aligned_reads / total_reads * 100.0) if total_reads else None
+
+    return {
+        'num_samples': len(samples_dict),
+        'total_reads': int(round(total_reads)),
+        'classified_pct': classified_pct,
+        'unique_taxids': len(unique_taxids),
+        'unique_genera': len(unique_genera),
+        'high_consequence': len(high_cons_taxids),
+    }
+
