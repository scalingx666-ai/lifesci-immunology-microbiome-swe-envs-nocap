diff --git a/build-scripts/docker_bases/alpine/Dockerfile b/build-scripts/docker_bases/alpine/Dockerfile
new file mode 100644
index 00000000..08cccbe9
--- /dev/null
+++ b/build-scripts/docker_bases/alpine/Dockerfile
@@ -0,0 +1,38 @@
+FROM alpine:edge
+
+LABEL maintainer "alves.rjc+docker@gmail.com"
+
+RUN echo '@testing http://dl-cdn.alpinelinux.org/alpine/edge/testing' >> /etc/apk/repositories && \
+    apk --no-cache add \
+    alpine-sdk \
+    bash \
+    bzip2-dev \
+    ca-certificates \
+    cabal@testing \
+    file \
+    ghc-dev@testing \
+    ghc@testing \
+    git \
+    gmp-dev \
+    libffi-dev \
+    libgcc \
+    linux-headers \
+    m4 \
+    make \
+    py2-pip \
+    python2 \
+    python2-dev \
+    vim \
+    xz \
+    xz-dev \
+    zlib-dev && \
+    wget -qO- https://get.haskellstack.org/ | sh && \
+    chmod 755 /usr/local/bin/stack && \
+    pip install tox
+
+# Build ngless dependencies to save time during build
+RUN git clone https://gitlab.com/ngless/ngless && \
+    cd ngless && \
+    STACKOPTS="--system-ghc --only-dependencies" make ngless && \
+    cd .. && \
+    rm -rf ngless
