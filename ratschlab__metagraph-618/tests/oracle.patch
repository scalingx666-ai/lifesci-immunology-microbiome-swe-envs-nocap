+const std::string& get_filename(std::istream &f) {
+    if (auto *mmap_in = dynamic_cast<sdsl::mmap_ifstream *>(&f))
+        return mmap_in->get_filename();
+    if (auto *named_in = dynamic_cast<named_ifstream *>(&f))
