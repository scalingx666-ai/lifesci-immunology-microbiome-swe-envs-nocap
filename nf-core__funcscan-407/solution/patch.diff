+                    "BGC_complete": BGC_complete,
+                    "BGC_start": BGC_start,
+                    "BGC_end": BGC_end,
+                    "BGC_length": BGC_length,
+                    "CDS_ID": ";".join(CDS_ID),
+                    "CDS_count": CDS_count,
+                    "PFAM_domains": ";".join(PFAM_domains),
+                    "MIBiG_ID": MIBiG_ID,
+                    "InterPro_ID": "NA",
