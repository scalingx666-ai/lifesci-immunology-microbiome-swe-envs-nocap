diff --git a/R/addAlpha.R b/R/addAlpha.R
index 5b2e6d3af..cf5bfa1d9 100644
--- a/R/addAlpha.R
+++ b/R/addAlpha.R
@@ -680,7 +680,10 @@ setMethod("getAlpha", signature = c(x = "SummarizedExperiment"),
     # There might be multiple indices; for instance chao1 has 2 values. For
     # every index calculate mean for each sample.
     res <- lapply(cnames, function(cname){
-        rowMeans2(res[, cname, drop = FALSE])
+        # After cbind, each index appears in niter columns (one per
+        # rarefaction round). Select all of them so that the mean is taken
+        # over every round, not just the first.
+        rowMeans2(res[, colnames(res) == cname, drop = FALSE])
     })
     names(res) <- cnames
     res <- do.call(cbind, res)
diff --git a/tests/testthat/test-addAlpha.R b/tests/testthat/test-addAlpha.R
index 6947f93cc..a1e67daec 100644
--- a/tests/testthat/test-addAlpha.R
+++ b/tests/testthat/test-addAlpha.R
@@ -159,3 +159,20 @@ test_that("Estimate Alpha Diversity Indices with Rarefaction", {
     res2 <- colData(tse)
     expect_equal(res, res2)
 })
+
+test_that("Rarefied alpha diversity is the mean over all iterations", {
+    data(GlobalPatterns, package="mia")
+    tse <- GlobalPatterns[, seq_len(10)]
+    res <- getAlpha(
+        tse, index = "chao1", sample = 10000, niter = 5,
+        BPPARAM = BiocParallel::SerialParam(RNGseed = 1))
+    # Rarefy the same rounds with the same seed and take the mean
+    ref <- BiocParallel::bplapply(seq_len(5), function(i){
+        x <- rarefyAssay(tse, sample = 10000, verbose = FALSE)
+        as.matrix(getAlpha(x, assay.type = "subsampled", index = "chao1"))
+    }, BPPARAM = BiocParallel::SerialParam(RNGseed = 1))
+    # The rounds must differ, otherwise any single round equals the mean
+    expect_false(identical(ref[[1]], ref[[2]]))
+    ref <- Reduce("+", ref) / length(ref)
+    expect_equal(as.matrix(res), ref)
+})
