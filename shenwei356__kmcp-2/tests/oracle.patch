+func minInt(a int, vals ...int) int {
+	min := a
+	for _, v := range vals {
+		if v < min {
+			min = v
+		}
+	}
+	return min
+}
+
+func maxInt(a int, vals ...int) int {
+	min := a
+	for _, v := range vals {
+		if v > min {
+			min = v
+		}
+	}
+	return min
+}
+
+func IntSlice2StringSlice(vals []int) []string {
+	s := make([]string, len(vals))
+	for i, v := range vals {
+		s[i] = strconv.Itoa(v)
+	}
+	return s
+}
