+class FastANI(object):
+    """Python wrapper for FastANI (https://github.com/ParBLiSS/FastANI)"""
+
+    def __init__(self, cpus):
+        """Instantiate the class.
+
+        Parameters
+        ----------
+        cpus : int
+            The number of CPUs to use.
+
+        """
