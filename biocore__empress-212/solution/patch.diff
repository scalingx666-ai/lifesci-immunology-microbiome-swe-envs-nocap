+    Empress.prototype.centerLayoutAvgPoint = function () {
+        if (!(this._currentLayout in this.layoutAvgPoint)) {
+            // Add up x and y coordinates of all nodes in the tree (using
+            // current layout).
+            var x = 0,
+                y = 0,
