+  expect_equal(d.set$act.rate, c(0.1, 0.2, 0.3, 0.4))
+  expect_equal(d.set$dummy.strat.param_1, c(1, 3, 5, 7))
+  expect_equal(d.set$dummy.strat.param_2, c(2, 4, 6, 8))
+})
