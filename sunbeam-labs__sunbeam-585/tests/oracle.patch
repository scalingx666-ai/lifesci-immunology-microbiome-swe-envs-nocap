diff --git a/sunbeam/workflow/scripts/sample_intake.py b/sunbeam/workflow/scripts/sample_intake.py
index d8755afe..b6a4b015 100755
--- a/sunbeam/workflow/scripts/sample_intake.py
+++ b/sunbeam/workflow/scripts/sample_intake.py
@@ -1,5 +1,16 @@
-import shutil
+import os
 
-with open(snakemake.log[0], "w") as log:
-    assert snakemake.input[0].endswith(".fastq.gz")
-    shutil.copy(snakemake.input[0], snakemake.output[0])
+
+log_fp = snakemake.log[0]  # type: ignore
+with open(log_fp, "w") as log:
+    try:
+        log.write("Starting ...\n")
+
+        input_reads = snakemake.input[0]  # type: ignore
+        output_reads = snakemake.output[0]  # type: ignore
+
+        assert input_reads.endswith(".fastq.gz")
+        os.symlink(input_reads, output_reads)
+    except BaseException as e:
+        log.write(f"Error during run: {e}\n")
+        raise e
