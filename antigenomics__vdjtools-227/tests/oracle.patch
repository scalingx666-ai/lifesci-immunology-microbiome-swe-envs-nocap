@@ -117,3 +117,14 @@ For source changes, use the repository environment and focused tests. For docs,
 install the docs extra in that environment and run `env -C docs make html` with
 zero warnings. Check examples against real signatures and CLI help. Do not rerun
 completed analyses or refit published corpora merely to update documentation.
+
+## Matched-subset discovery
+
+`stats.subset_rarefaction_batch(samples, population_sizes, sizes=..., threads=...)`
+uses the existing native q=0 engine at whole-population integer depths. Inputs
+are positive source-clonotype count vectors, possibly empty; population totals
+include unmatched reads. It subtracts the temporary unmatched category through
+SciPy hypergeometric presence, and returns sample/m/qD. No extrapolation, SE or
+subset-coverage claim. For Shannon and Simpson rarefaction reuse
+`stats.inext_batch(q=(0,1,2))`; q=1 is exp(Shannon entropy), q=2 is inverse
+Simpson and Gini–Simpson equals 1-1/qD for q=2.
diff --git a/tests/python/test_subset_rarefaction.py b/tests/python/test_subset_rarefaction.py
new file mode 100644
index 00000000..23e53bff
--- /dev/null
+++ b/tests/python/test_subset_rarefaction.py
@@ -0,0 +1,21 @@
+"""Subset discovery uses total reads, with exact finite-population oracles."""
+import math
+import numpy as np
+import pytest
+from vdjtools.stats import subset_rarefaction_batch
+
+
+def test_subset_batch_matches_exact_sampling_and_endpoints():
+    vectors=[[1,2],[],[8],[1]*8,[2,3]]
+    curve=subset_rarefaction_batch(vectors,[8]*5,sizes=range(9),threads=2)
+    assert curve.height==45
+    for i,x in enumerate(vectors):
+        got=curve.filter(curve['sample']==i)['qD'].to_numpy()
+        want=[sum(1-(math.comb(8-c,m) if 8-c>=m else 0)/math.comb(8,m) for c in x) for m in range(9)]
+        np.testing.assert_allclose(got,want,atol=1e-12)
+
+
+@pytest.mark.parametrize('counts,total,depths', [([1.5],8,[1]),([9],8,[1]),([1],0,[0]),([1],8,[9]),([1],8,[.5]),([float('nan')],8,[1])])
+def test_subset_rejects_invalid_inputs(counts,total,depths):
+    with pytest.raises(ValueError):
+        subset_rarefaction_batch([counts],[total],sizes=depths,threads=1)
