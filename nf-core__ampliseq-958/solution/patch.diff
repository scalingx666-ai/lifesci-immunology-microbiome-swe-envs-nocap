diff --git a/conf/aws_scratch.config b/conf/aws_scratch.config
new file mode 100644
index 000000000..d20d32453
--- /dev/null
+++ b/conf/aws_scratch.config
@@ -0,0 +1,17 @@
+/*
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+    Nextflow config file for running tests on AWS
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+    Custom config for runs on AWS.
+
+----------------------------------------------------------------------------------------
+*/
+
+process {
+    withName:'.*QIIME2.*' {
+        scratch = true
+    }
+    withName:'NFCORE_AMPLISEQ:AMPLISEQ:PICRUST' {
+        memory = '40.GB'
+    }
+}
