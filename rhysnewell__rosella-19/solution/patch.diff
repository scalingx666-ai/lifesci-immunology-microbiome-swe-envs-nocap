diff --git a/.github/workflows/release-rosella.yml b/.github/workflows/release-rosella.yml
new file mode 100755
index 00000000..86b61adb
--- /dev/null
+++ b/.github/workflows/release-rosella.yml
@@ -0,0 +1,43 @@
+name: Publish Release
+on:
+  push:
+    tags:
+      - v*
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@master
+        if: github.actor != 'dependabot[bot]'
+      - name: Set env
+        run: echo "RELEASE_VERSION=${GITHUB_REF#refs/*/}" >> $GITHUB_ENV
+      - id: 'compile'
+        uses: rhysnewell/rust-cargo-musl-action@v0.1.15
+        with:
+          command: 'build'
+          flags: '--features vendored-openssl'
+      - name: Package binaries
+        run: mkdir -p release/ && cp ${{ steps.compile.outputs.release-dir }}/rosella ${{ steps.compile.outputs.release-dir }}/remove_minimap2_duplicated_headers INSTALL.md release/
+      - name: Compress action step
+        uses: master-atul/tar-action@v1.0.2
+        id: compress
+        with:
+          command: c
+          cwd: ./
+          files: |
+            ./release/
+          outPath: rosella-x86_64-unknown-linux-musl-${{ env.RELEASE_VERSION }}.tar.gz
+      - uses: actions/upload-artifact@v2
+        with:
+          name: binary
+          path: rosella-x86_64-unknown-linux-musl-${{ env.RELEASE_VERSION }}.tar.gz
+      - name: Create a Release
+        if: github.actor != 'dependabot[bot]'
+        uses: "marvinpinto/action-automatic-releases@latest"
+        with:
+          repo_token: "${{ secrets.RELEASE_TOKEN }}"
+          prerelease: false
+          automatic_release_tag: "latest"
+          title: "${{ env.RELEASE_VERSION }}"
+          files: |
+            rosella-x86_64-unknown-linux-musl-${{ env.RELEASE_VERSION }}.tar.gz
\ No newline at end of file
diff --git a/INSTALL.md b/INSTALL.md
new file mode 100755
index 00000000..3bb6fab6
--- /dev/null
+++ b/INSTALL.md
@@ -0,0 +1,6 @@
+Rosella currently comes with 2 binaries:
+
+* rosella - the main binary invoked
+* remove_minimap2_duplicated_headers - Implements a fix for https://github.com/lh3/minimap2/issues/527
+
+Both binaries must be in your PATH variable in order to be run.
\ No newline at end of file
