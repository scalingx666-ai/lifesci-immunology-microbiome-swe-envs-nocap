+    points_rc = prc([(1,2), (3,3)], [1, 2])
+    r = Circuitscape.create_new_polymap(gmap, poly, points_rc, 0, 0, pmap(points_rc, 4))
+    nm = Circuitscape.construct_node_map(gmap, r)
+    @test nm[1,1] == nm[1,2]
+    @test nm[3,3] != nm[1,1]
+end
