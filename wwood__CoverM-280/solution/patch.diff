+            MappingProgram::BWA_MEM => {
+                external_command_checker::check_for_bwa();
+            }
+            MappingProgram::BWA_MEM2 => {
+                external_command_checker::check_for_bwa_mem2();
+            }
+            MappingProgram::MINIMAP2_SR
