+                    'sample_values': layer['sample_values'],
+                    'group_samples': layer.get('group_samples'),
+                    'slice_share_summary': layer['slice_share_summary'],
+                    'sample_weights': element['sample_weights'],
+                    'unified_weights': element['unified_weights']
+                }
