+        """
+        view = {
+            key: layer[key] for key in (
+                'group_samples', 'sample_aggregate', 'group_aggregate', 'value_order', 'seed',
+                'accession_rule', 'sample_rule', 'group_rule', '_choices', '_undefined_individual',
+                '_undefined_unified'
+            ) if key in layer
+        }
