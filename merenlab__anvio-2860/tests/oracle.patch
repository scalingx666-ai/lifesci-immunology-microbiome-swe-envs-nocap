+    @staticmethod
+    def _slice_values(
+        accessions: Tuple[str, ...],
+        layer: dict,
+        context: Union[str, None]
+    ) -> Dict[Union[str, Tuple[str, Tuple[str, ...]]], Union[float, str]]:
+        """
+        Find the value of each slice of a map element on one map.
