+                        width=6,
+                    ),
+                    dbc.Col(
+                        html.Div(
+                            dbc.RadioItems(
+                                options=[
+                                    {
+                                        "label": "Node(s)",
+                                        "value": ui_config.GRAPH_SEQ,
