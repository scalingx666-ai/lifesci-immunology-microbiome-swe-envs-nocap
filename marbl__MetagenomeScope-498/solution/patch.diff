+                        width=6,
+                    ),
+                ],
+                style={"margin-bottom": "0.5em"},
+            ),
+            html.Div(
+                dbc.InputGroup(
+                    [
+                        dbc.InputGroupText("Node name(s)"),
+                        dbc.Input(
+                            type="text",
+                            id=f"{idprefix}GraphSeq",
