+                            ),
+                            ui_config.OPTIONS_SEP,
+                            dbc.InputGroup(
+                                [
+                                    dbc.InputGroupText(
+                                        "Marker size",
+                                        className="input-group-text-next-to-radio-button-group",
+                                    ),
+                                    html.Div(
+                                        dbc.RadioItems(
+                                            options=[
+                                                {
+                                                    "label": "Autoselect",
+                                                    "value": ui_config.MARKERSIZE_AUTO,
+                                                },
+                                                {
+                                                    "label": [
+                                                        html.Span(
+                                                            "Specify manually",
+                                                            style={
+                                                                "padding-right": "0.7em"
