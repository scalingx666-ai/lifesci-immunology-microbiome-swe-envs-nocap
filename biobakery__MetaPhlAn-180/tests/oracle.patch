+def vsc_bowtie2(profile_vsc_folder, nproc, file_format="fasta",
+                exe=None,bt2build_exe=None, min_alignment_len=None, read_min_len=0):
+
+    try:
+        subp.check_call([exe if exe else 'bowtie2', "-h"], stdout=DEVNULL)
