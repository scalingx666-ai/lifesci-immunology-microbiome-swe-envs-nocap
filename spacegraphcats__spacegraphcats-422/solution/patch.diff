     print(f"wrote {filenum+1} files containing cdbg_ids.")
 
+    # write out cdbg id to record mapping, one per row
+    with open(args.output_cdbg_annot, "wt") as fp:
+        w = csv.writer(fp)
+        w.writerow(
+            [
+                "filename",
+                "record_name",
+                "record_number",
+                "catlas_base",
+                "cdbg_id",
+            ]
+        )
