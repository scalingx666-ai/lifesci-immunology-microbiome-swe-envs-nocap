diff --git a/client/src/redux/reducers/behavior.js b/client/src/redux/reducers/behavior.js
new file mode 100644
index 00000000..1826eaa6
--- /dev/null
+++ b/client/src/redux/reducers/behavior.js
@@ -0,0 +1,16 @@
+export const OPEN_BEHAVIOR = 'OPEN_BEHAVIOR';
+
+const initialState = {
+  isSubmitted: null,
+};
+
+const openBehaviorReducer = (state = initialState, action) => {
+  switch (action.type) {
+    case OPEN_BEHAVIOR:
+      return { isSubmitted: true };
+    default:
+      return state;
+  }
+};
+
+export default openBehaviorReducer;
