+u0 = [10.0, 100.0, 50.0];
+p = [.3, .015, .7, 0.01, 0.5];
+prob = ODEProblem(vectorfield(lotka_petri),u0,(0.0,100.0),p);
+sol = solve(prob,Tsit5());
+plot(sol, label=["Rabbits" "Wolves" "Hawks"])
