-#' # Shows all indices
-#' colData(esophagus)
-#' # Deletes all indices
-#' colData(esophagus) <- NULL
-#'
-#' # Calculates all indices with explicitly specified names
-#' esophagus <- .estimate_dominance(esophagus,
-#'     index = c("dbp", "dmn", "absolute", "relative",
-#'               "simpson_lambda", "core_abundance", "gini"),
