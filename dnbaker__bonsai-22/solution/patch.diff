+using alph::DAYHOFF;
+using alph::DNA5;
+using alph::DNA4;
+using alph::DNA2KETAMINE;
+using alph::DNA2PYRPUR;
+
+
+} // namespace bns
+
+
+#endif /* BNS_ALPHBET_H__ */
