index 0000000..9d4c7b5
--- /dev/null
+++ b/.github/workflows/test_flowkit.yml
@@ -0,0 +1,76 @@
+name: Test FlowKit downstream
+
+on: [push]
+
+jobs:
+  test-develop:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        python-version: ["3.7", "3.8", "3.9", "3.10"]
+
+    steps:
+      - name: Setup Python
+        uses: actions/setup-python@v2
+        with:
+          python-version: ${{ matrix.python-version }}
+
+      - name: Checkout FlowIO
+        uses: actions/checkout@v3
+        with:
+          path: flowio
+
+      - name: Checkout FlowKit (develop)
+        uses: actions/checkout@v3
+        with:
+          repository: whitews/FlowKit
+          ref: develop
+          path: flowkit
+
+      - name: Install FlowKit
+        working-directory: flowkit
+        run: |
+          pip install -r requirements.txt
+          pip install ../flowio
+
+      - name: Run FlowKit tests
+        working-directory: flowkit
+        run: |
+          python3 ./run_tests.py
+
+  test-master:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        python-version: ["3.7", "3.8", "3.9", "3.10"]
+
+    steps:
+      - name: Setup Python
+        uses: actions/setup-python@v2
+        with:
+          python-version: ${{ matrix.python-version }}
+
+      - name: Checkout FlowIO
+        uses: actions/checkout@v3
+        with:
+          path: flowio
+
+      - name: Checkout FlowKit (master)
+        uses: actions/checkout@v3
+        with:
+          repository: whitews/FlowKit
+          ref: master
+          path: flowkit
+
+      - name: Install FlowKit
+        working-directory: flowkit
+        run: |
+          pip install -r requirements.txt
+          pip install ../flowio
+
+      - name: Run FlowKit tests
+        working-directory: flowkit
+        run: |
+          python3 ./run_tests.py
