+def write_header(sam_file, sequence_ids, stdout=False):
+    header_lines = ["@HD\tVN:1.4\tSQ:unsorted"]
+    header_lines.extend(f"@SQ\tSN:{prefix}\tLN:{len(sequence_ids[prefix])}" for prefix in sequence_ids)
+
+    if stdout:
