+def get_cigar_length(cigar):
+    length = 0
+    decimals = []
+    for char in cigar:
+        try:
+            x = int(char)
+            decimals.append(x)
+        except ValueError:
+            if char != "D":
+                for i in range(len(decimals)):
+                    length += 10**(len(decimals) - i - 1) * decimals[i]
+            decimals = []
+    return length
