diff --git a/metagraph/CMakeLists.txt b/metagraph/CMakeLists.txt
index 73cf10c6e8..bb3b897aa0 100644
--- a/metagraph/CMakeLists.txt
+++ b/metagraph/CMakeLists.txt
@@ -1,4 +1,6 @@
-cmake_minimum_required(VERSION 3.19)
+cmake_minimum_required(VERSION 3.16...3.30)
+set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
+set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
 cmake_policy(SET CMP0015 NEW)
 
 # Read version from JSON
@@ -112,12 +114,12 @@ if (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
     -Wno-exit-time-destructors
     -Wno-deprecated-declarations
     -Wno-vla-extension
+    -Wno-deprecated-copy
   )
 
   if (NOT CMAKE_CXX_COMPILER_ID MATCHES "AppleClang")
     add_compile_options(
      -Wno-suggest-destructor-override
-     -Wno-deprecated-copy
      -Wno-deprecated-declarations
     )
   endif()
@@ -133,8 +135,10 @@ if(APPLE)
   endif()
   if(EXISTS /opt/homebrew/opt/icu4c/lib)
     link_directories(/opt/homebrew/opt/icu4c/lib)
+  elseif(EXISTS /usr/local/opt/icu4c/lib)
+    link_directories(/usr/local/opt/icu4c/lib)
   else()
-    message(FATAL_ERROR "ICU libs not found")
+    message(FATAL_ERROR "ICU libs not found. Install with `brew install icu4c`.")
   endif()
   include(CheckCXXCompilerFlag)
   check_cxx_compiler_flag(-Wno-poison-system-directories SUPPORT_NO_POISON_SYS_DIR)
@@ -301,12 +305,7 @@ target_compile_options(eigen INTERFACE -Wno-unused-but-set-variable -Wno-unused-
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${CMAKE_SOURCE_DIR})
 
-if(NO_ZSTD)
-  set(ZSTD_FOUND FALSE)
-else()
-  find_package(zstd)
-endif()
-
+find_package(zstd)
 if(ZSTD_FOUND)
   add_definitions(-D_SUPPORT_ZSTD)
 else()
@@ -358,6 +357,11 @@ target_compile_options(zlib
     -Wno-maybe-uninitialized
 )
 
+add_library(folly STATIC
+  external-libraries/folly/folly/lang/SafeAssert.cpp
+  external-libraries/folly/folly/lang/ToAscii.cpp
+)
+
 add_library(progress_bar STATIC
   external-libraries/cpp_progress_bar/progress_bar.cpp
 )
@@ -445,6 +449,7 @@ set(METALIBS ${METALIBS}
   ips4o
   caches
   eigen
+  folly
 )
 if(APPLE)
   set(METALIBS ${METALIBS} ${OpenMP_CXX_LIBRARIES})
