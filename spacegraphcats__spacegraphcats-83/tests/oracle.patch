diff --git a/search/memoize.py b/search/memoize.py
new file mode 100644
index 00000000..31c42375
--- /dev/null
+++ b/search/memoize.py
@@ -0,0 +1,11 @@
+import functools
+
+def memoize(func):
+    cache = func.cache = {}
+    @functools.wraps(func)
+    def memoized_func(*args, **kwargs):
+        key = str(args) + str(kwargs)
+        if key not in cache:
+            cache[key] = func(*args, **kwargs)
+        return cache[key]
+    return memoized_func
