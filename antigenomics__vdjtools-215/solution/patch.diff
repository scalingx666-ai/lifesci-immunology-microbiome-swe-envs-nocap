+def require_serial_pools(*, outer: bool = True) -> None:
+    """Check immutable pool allocation; outer workers additionally require serial kernels."""
     import polars as pl
+
+    pool = pl.thread_pool_size()
+    budget = available_cores()
+    if pool > budget:
