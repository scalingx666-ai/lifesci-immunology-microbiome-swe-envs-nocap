+                ((label_gap, label_gap), 'left', 'bottom'),
+                ((label_gap, 0), 'left', 'center'),
+                ((0, -label_gap), 'center', 'top'),
+                ((-label_gap, 0), 'right', 'center'),
+                ((-label_gap, label_gap), 'right', 'bottom')
