+        Dict[str, Union[str, list]]
+            The glyph.
+        """
+        start, end = extent
+        return {
+            'track': BAR_TRACK_COLOR,
+            'wedges': [(start, end, color)],
+            'rules': [(end, BAR_END_LINE_COLOR, BAR_END_LINE_WIDTH)]
+        }
