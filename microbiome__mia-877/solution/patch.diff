diff --git a/R/applyByModule.R b/R/applyByModule.R
index 1b637a75a..e86b3feba 100644
--- a/R/applyByModule.R
+++ b/R/applyByModule.R
@@ -222,8 +222,11 @@ setMethod("applyByModule", "SummarizedExperiment", function(x, .by, .group, FUN,
         stop("No '.group' has size above 'min.group.size'.", call. = FALSE)
     }
 
-    # Compute
-    res <- bplapply(idx, function(i) FUN(x[i, ], ...))
+    # Compute. FUN and its arguments are evaluated here so that workers
+    # running in separate sessions do not need to find them.
+    force(FUN)
+    args <- list(...)
+    res <- bplapply(idx, function(i) do.call(FUN, c(list(x[i, ]), args)))
 
     return(list(res = res, group = .group))
 }
diff --git a/tests/testthat/test-applyByModule.R b/tests/testthat/test-applyByModule.R
index c3b34d94f..050181061 100644
--- a/tests/testthat/test-applyByModule.R
+++ b/tests/testthat/test-applyByModule.R
@@ -57,3 +57,21 @@ test_that("applyByModule", {
     
     expect_in(names(metadata(tse)), "tree_plots")
 })
+
+test_that("applyByModule works with workers in separate sessions", {
+    library(bluster)
+    tse <- TreeSummarizedExperiment::makeTSE(nrow = 20, ncol = 10)
+    assayNames(tse) <- "counts"
+    rowData(tse)$var1 <- rep(letters[1:2], 10)
+    old <- BiocParallel::bpparam()
+    BiocParallel::register(BiocParallel::SnowParam(2))
+    on.exit(BiocParallel::register(old))
+    # Workers do not have bluster attached, so KmeansParam must be evaluated
+    # before the arguments are sent to them
+    tse <- applyByModule(
+        tse, "rows", "var1", getCluster,
+        BLUSPARAM = KmeansParam(centers = 2),
+        assay.type = "counts", by = "cols", clust.col = "kmeans"
+    )
+    expect_contains(names(colData(tse)), c("kmeans_a", "kmeans_b"))
+})
