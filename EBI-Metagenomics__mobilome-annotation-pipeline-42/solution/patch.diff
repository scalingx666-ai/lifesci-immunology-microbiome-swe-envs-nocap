diff --git a/modules/cleanup.nf b/modules/cleanup.nf
new file mode 100644
index 00000000..2f3c9d91
--- /dev/null
+++ b/modules/cleanup.nf
@@ -0,0 +1,17 @@
+#!/usr/bin/env nextflow
+nextflow.enable.dsl=2
+
+process CLEANUP {
+    input:
+    path tmp_dir
+    path icefinder_summary 
+
+    script:
+    """
+    echo "Cleaning up ICEFINDER tmp directories..."
+
+    real_tmp_dir=\$(readlink -f "${tmp_dir}")
+    ls -la \${real_tmp_dir}
+    rm -rf \${real_tmp_dir}
+    """
+}
