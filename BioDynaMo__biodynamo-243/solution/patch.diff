+  x_axis_ = rhs.GetXAxis();
+  y_axis_ = rhs.GetYAxis();
+  z_axis_ = rhs.GetZAxis();
+
+  SetSpringAxis(rhs.GetSpringAxis());
+  branch_order_ = rhs.GetBranchOrder();
+  spring_constant_ = rhs.GetSpringConstant();
