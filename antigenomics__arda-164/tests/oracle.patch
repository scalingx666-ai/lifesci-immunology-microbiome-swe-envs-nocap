+def test_upstream_v_frameshift_keeps_local_junction_but_not_productivity(human_ref):
+    """Observed local translation survives upstream indels without certifying the receptor."""
+    fa, ref, ids = human_ref
+    sid = next(i for i in ids if i.startswith("IGH_") and ref[i]["cdr3_start"])
+    sequence = fa[sid]
+    position = int(ref[sid]["cdr3_start"]) - 30
+    inputs = [("control", sequence)] + [
+        (f"upstream{n}", sequence[:position] + "A" * n + sequence[position:])
+        for n in (1, 2)
+    ]
+    rows = {r["sequence_id"]: r for r in annotate_records(inputs, "human", "nt", threads=4)}
+    control = rows["control"]
+    for n in (1, 2):
+        row = rows[f"upstream{n}"]
+        assert row["junction"] == control["junction"]
+        assert row["junction_aa"] == control["junction_aa"]
+        assert row["vj_in_frame"] == "F"
+        assert row["productive"] == "F"
diff --git a/tests/unit/test_junction_local_phase.py b/tests/unit/test_junction_local_phase.py
new file mode 100644
index 0000000..855f1fa
--- /dev/null
+++ b/tests/unit/test_junction_local_phase.py
@@ -0,0 +1,26 @@
+"""Local junction rendering must not bridge an upstream coding-frame offset."""
+import pytest
+
+from arda.annotate.transfer import _junction_nt
+
+
+@pytest.mark.parametrize("coding_start", [1, 2, 3])
+def test_upstream_phase_does_not_change_local_junction_translation(coding_start):
+    nucleotide, protein, cdr3, phase = _junction_nt("TGTAAATGG", 4, 7, coding_start, 3)
+    assert nucleotide == "TGTAAATGG"
+    assert protein == "CKW"
+    assert cdr3 == "K"
+    assert phase == (7 - coding_start) % 3
+
+
+@pytest.mark.parametrize("inserted", ["A", "AA"])
+@pytest.mark.parametrize("coding_start", [1, 2, 3])
+def test_local_frameshift_still_bridges_into_the_terminal_anchor(inserted, coding_start):
+    sequence = "TGTAAA" + inserted + "TGG"
+    nucleotide, protein, cdr3, phase = _junction_nt(
+        sequence, 4, len(sequence) - 2, coding_start, 6)
+    assert nucleotide == sequence
+    assert "_" in protein
+    assert protein.startswith("C") and protein.endswith("W")
+    assert cdr3 == protein[1:-1]
+    assert phase == (len(sequence) - 2 - coding_start) % 3
