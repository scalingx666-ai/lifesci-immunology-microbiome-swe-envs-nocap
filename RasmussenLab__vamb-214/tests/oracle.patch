-
-    __slots__ = ["name", "contigs", "intersections", "breadth"]
-
-    def __init__(self, name: str) -> None:
-        self.name = name
-        self.contigs: set[Contig] = set()
-        self.intersections: dict[Genome, int] = dict()
-        self.breadth: int = 0
