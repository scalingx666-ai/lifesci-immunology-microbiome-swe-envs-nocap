 """Unit tests for mmseqs binary discovery and static-binary auto-fetch (offline)."""
 
+from pathlib import Path
+
 import pytest
 
 from arda import _mmseqs_fetch, mmseqs
@@ -56,3 +58,120 @@ def _boom(*a, **k):  # auto-fetch must NOT be attempted
