+        EXPECT_EQ(1u, merged.get_column("stays_sparse").num_set_bits());
+        EXPECT_TRUE(merged.get_column("stays_sparse")[7]);
+        EXPECT_EQ(0u, merged.get_column("empty").num_set_bits());
+    }
