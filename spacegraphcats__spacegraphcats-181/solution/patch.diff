index 79b23c0c..5a753a29 100755
--- a/search/frontier_search.py
+++ b/search/frontier_search.py
@@ -3,6 +3,7 @@
 import os
 import sys
 from copy import copy
+import heapq
 
 import sourmash_lib
 from sourmash_lib import MinHash, signature
@@ -78,7 +79,7 @@ def add_to_frontier4(node_id):
 
         if node_id in seen_nodes:
             return
-            
