+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/AllGenerics.R, R/subsetBy.R
+\name{subsetBy}
+\alias{subsetBy}
+\alias{subsetBy,SummarizedExperiment-method}
+\title{Subset features or samples by conditions on the data}
+\usage{
+subsetBy(
+  x,
+  rows = NULL,
+  cols = NULL,
+  collapse = FALSE,
+  collapse.name = "Other",
+  ...
+)
+
+\S4method{subsetBy}{SummarizedExperiment}(
+  x,
+  rows = NULL,
+  cols = NULL,
+  collapse = FALSE,
+  collapse.name = "Other",
+  ...
+)
+}
+\arguments{
+\item{x}{a \code{\link[SummarizedExperiment]{SummarizedExperiment}} object.}
+
+\item{rows}{An expression that returns a \code{logical} vector with one
+value per feature, or \code{NULL} to keep all features. (Default:
+\code{NULL})}
+
+\item{cols}{An expression that returns a \code{logical} vector with one
+value per sample, or \code{NULL} to keep all samples. (Default:
+\code{NULL})}
+
+\item{collapse}{\code{Logical scalar}. Should the features that do not
+meet the \code{rows} condition be merged into one feature instead of being
+removed? (Default: \code{FALSE})}
+
+\item{collapse.name}{\code{Character scalar}. Name of the merged feature
+when \code{collapse = TRUE}. (Default: \code{"Other"})}
+
+\item{...}{additional arguments passed to
+\code{\link[=agglomerateByVariable]{agglomerateByVariable}} when
+\code{collapse = TRUE}, e.g. \code{update.tree}.}
+}
+\value{
+\code{x} with the features and samples that meet the conditions.
+}
+\description{
+\code{subsetBy} keeps the features (rows) and samples (columns) that meet
+conditions written as R expressions. The conditions are evaluated on the
+object that is passed to the function, so when several \code{subsetBy}
+calls are piped, each condition is computed from the data that remains
+after the previous steps.
+}
+\details{
+The expressions can refer to the assays by their names (e.g.
+\code{counts}), which are available as matrices. \code{rows} can also
+refer to the columns of \code{rowData(x)}, and \code{cols} to the columns of
+\code{colData(x)}. If an assay and a \code{rowData} or \code{colData}
+column have the same name, the assay is used. Other variables, such as
+thresholds, are taken from the environment where \code{subsetBy} is called.
+
+\code{rows} is evaluated before \code{cols}, and \code{cols} is evaluated
+on the data that remains after subsetting the rows. \code{NA} values in
+the result of a condition are treated as \code{FALSE}.
+
+With \code{collapse = TRUE}, the features that do not meet the \code{rows}
+condition are merged into a single feature named \code{collapse.name},
+placed after the kept features. Its values are the sums of the merged
+features, so the sample totals stay the same. This is useful, for example,
+for plotting the most abundant features together with the rest. Summing is
+meaningful for counts and relative abundances but not for transformed
+values such as clr. The merging is done with
+\code{\link[=agglomerateByVariable]{agglomerateByVariable}}, which drops the
+\code{rowTree} unless \code{update.tree = TRUE}. \code{collapse} affects
+only features; samples that do not meet the \code{cols} condition are
+always removed.
+}
+\examples{
+data(GlobalPatterns)
+tse <- GlobalPatterns
+
+# Keep features with more than 10 counts in total
+tse_sub <- subsetBy(tse, rows = rowSums(counts) > 10)
+
+# Filter in steps. Each step is computed from the data left by the
+# previous step, so library sizes are calculated after the rare features
+# have been removed.
+tse_sub <- tse |>
+    subsetBy(rows = rowSums(counts) > 10) |>
+    subsetBy(rows = rowMeans(counts > 0) > 0.25) |>
+    subsetBy(cols = colSums(counts) > 100000)
+
+# Keep the features with a mean relative abundance above 1\% and merge the
+# rest into one feature called "Other"
+tse <- transformAssay(tse, method = "relabundance")
+tse_sub <- subsetBy(
+    tse, rows = rowMeans(relabundance) > 0.01, collapse = TRUE)
+tail(rownames(tse_sub))
+
+# Combine different subsettings in a pipe: first remove samples with
+# fewer than 500,000 reads, then keep the 5 most abundant features and
+# merge the rest into "Other". The result can be plotted, e.g., with
+# miaViz::plotBoxplot() or miaViz::plotAbundance().
+tse_top <- GlobalPatterns |>
+    subsetBy(cols = colSums(counts) >= 500000) |>
+    transformAssay(method = "relabundance") |>
+    subsetBy(rows = rank(-rowMeans(relabundance)) <= 5, collapse = TRUE)
+dim(tse_top)
+rownames(tse_top)
+
+# Plot the top features and "Other" by sample type
+if( requireNamespace("miaViz", quietly = TRUE) ){
+    miaViz::plotBoxplot(
+        tse_top, assay.type = "relabundance",
+        x = "SampleType", fill.by = "SampleType",
+        facet.by = "rownames", scales = "free_y")
+}
+
+# Conditions can also use rowData and colData variables
+tse_sub <- subsetBy(
+    tse, rows = Kingdom == "Bacteria", cols = SampleType == "Feces")
+
+# This includes quality control metrics stored with addQC(). Note that
+# stored metrics are not updated when the data is subsetted, so in stepwise
+# filtering, compute the metric in the condition or call addQC() again.
+tse <- addQC(tse, by = "rows")
+tse <- addQC(tse, by = "cols")
+tse_sub <- subsetBy(tse, rows = sd > 0 & detected >= 3, cols = total > 1e6)
+
+}
+\seealso{
+\code{\link[=getPrevalence]{getPrevalent}},
+\code{\link[=addQC]{addQC}}
+}
diff --git a/tests/testthat/test-subsetBy.R b/tests/testthat/test-subsetBy.R
new file mode 100644
index 000000000..281784f8b
--- /dev/null
+++ b/tests/testthat/test-subsetBy.R
@@ -0,0 +1,139 @@
+context("subsetBy")
+
+test_that("subsetBy", {
+    data(GlobalPatterns, package = "mia")
+    tse <- GlobalPatterns
+    mat <- assay(tse, "counts")
+    # Rows
+    res <- subsetBy(tse, rows = rowSums(counts) > 10)
+    expect_s4_class(res, "TreeSummarizedExperiment")
+    expect_identical(rownames(res), rownames(tse)[rowSums(mat) > 10])
+    expect_identical(ncol(res), ncol(tse))
+    # Columns
+    res <- subsetBy(tse, cols = colSums(counts) > 1e6)
+    expect_identical(colnames(res), colnames(tse)[colSums(mat) > 1e6])
+    expect_identical(nrow(res), nrow(tse))
+    # rowData and colData variables, and variables from the caller
+    th <- "Feces"
+    res <- subsetBy(
+        tse, rows = Kingdom == "Bacteria", cols = SampleType == th)
+    expect_true(all(rowData(res)$Kingdom == "Bacteria"))
+    expect_true(all(res$SampleType == "Feces"))
+    # Stepwise filtering computes each condition from the subsetted data
+    res <- tse |>
+        subsetBy(rows = rowSums(counts) > 10) |>
+        subsetBy(rows = rowMeans(counts > 0) > 0.25) |>
+        subsetBy(cols = colSums(counts) > 100000)
+    ref <- tse
+    ref <- ref[rowSums(assay(ref, "counts")) > 10, ]
+    ref <- ref[rowMeans(assay(ref, "counts") > 0) > 0.25, ]
+    ref <- ref[, colSums(assay(ref, "counts")) > 100000]
+    expect_identical(dimnames(res), dimnames(ref))
+    # cols is evaluated after rows
+    res <- subsetBy(
+        tse, rows = rowSums(counts) > 10, cols = colSums(counts) > 100000)
+    sub <- tse[rowSums(mat) > 10, ]
+    expect_identical(
+        colnames(res),
+        colnames(sub)[colSums(assay(sub, "counts")) > 100000])
+    # NULL keeps everything
+    expect_identical(dim(subsetBy(tse)), dim(tse))
+    # NA is treated as FALSE
+    res <- subsetBy(tse, rows = ifelse(rowSums(counts) > 10, TRUE, NA))
+    expect_identical(nrow(res), sum(rowSums(mat) > 10))
+    # Errors
+    expect_error(subsetBy(tse, rows = 1))
+    expect_error(subsetBy(tse, rows = c(TRUE, FALSE)))
+    expect_error(subsetBy(tse, cols = rowSums(counts) > 0))
+})
+
+test_that("subsetBy with collapse", {
+    data(GlobalPatterns, package = "mia")
+    tse <- GlobalPatterns
+    mat <- assay(tse, "counts")
+    keep <- rowSums(mat) > 1e5
+    res <- subsetBy(tse, rows = rowSums(counts) > 1e5, collapse = TRUE)
+    # Kept features in the original order, then the merged feature
+    expect_identical(rownames(res), c(rownames(tse)[keep], "Other"))
+    expect_equal(
+        unname(assay(res, "counts")["Other", ]),
+        unname(colSums(mat[!keep, ])))
+    # Sample totals do not change
+    expect_equal(colSums(assay(res, "counts")), colSums(mat))
+    # Kept features are unchanged
+    expect_equal(
+        assay(res, "counts")[rownames(tse)[keep], ], mat[keep, ])
+    # Custom name
+    res <- subsetBy(
+        tse, rows = rowSums(counts) > 1e5, collapse = TRUE,
+        collapse.name = "Rest")
+    expect_identical(tail(rownames(res), 1), "Rest")
+    # Nothing to merge: the object is returned as subsetted
+    res <- subsetBy(tse, rows = rowSums(counts) >= 0, collapse = TRUE)
+    expect_identical(dim(res), dim(tse))
+    # cols is evaluated after collapsing, so totals include the merged feature
+    res <- subsetBy(
+        tse, rows = rowSums(counts) > 1e5, cols = colSums(counts) > 1e6,
+        collapse = TRUE)
+    expect_identical(colnames(res), colnames(tse)[colSums(mat) > 1e6])
+    # Errors
+    expect_error(subsetBy(tse, rows = rowSums(counts) > 0, collapse = 1))
+    expect_error(
+        subsetBy(tse, rows = rowSums(counts) > 0, collapse = TRUE,
+            collapse.name = c("a", "b")))
+    tse2 <- tse
+    rownames(tse2)[1] <- "Other"
+    expect_error(
+        subsetBy(tse2, rows = rowSums(counts) > 1e5 | rownames(tse2) ==
+            "Other", collapse = TRUE))
+})
+
+test_that("subsetBy with stored quality control metrics", {
+    data(GlobalPatterns, package = "mia")
+    tse <- GlobalPatterns
+    tse <- addQC(tse, by = "rows")
+    tse <- addQC(tse, by = "cols")
+    # rowData and colData metrics
+    res <- subsetBy(tse, rows = sd > 0 & detected >= 3, cols = total > 1e6)
+    ref <- tse[
+        rowData(tse)$sd > 0 & rowData(tse)$detected >= 3, tse$total > 1e6]
+    expect_identical(dimnames(res), dimnames(ref))
+    # Stored metrics combined with assays and collapse
+    keep <- rowData(tse)$sd > 0 & rowSums(assay(tse, "counts") > 0) >= 3
+    res <- subsetBy(
+        tse, rows = sd > 0 & rowSums(counts > 0) >= 3, collapse = TRUE)
+    expect_identical(rownames(res), c(rownames(tse)[keep], "Other"))
+    # Stored metrics are not updated after subsetting, unlike metrics computed
+    # in the condition
+    sub <- subsetBy(tse, rows = rowSums(counts) > 1e5)
+    expect_identical(sub$total, tse$total)
+    expect_false(
+        identical(
+            colnames(subsetBy(sub, cols = total > 1e5)),
+            colnames(subsetBy(sub, cols = colSums(counts) > 1e5))))
+    # Assays take precedence over rowData/colData fields with the same name
+    tse2 <- tse
+    rowData(tse2)$counts <- rep(-1, nrow(tse2))
+    res <- subsetBy(tse2, rows = rowSums(counts) > 1e5)
+    expect_identical(
+        rownames(res), rownames(tse)[rowSums(assay(tse, "counts")) > 1e5])
+})
+
+test_that("subsetBy with different subsettings in a pipe", {
+    data(GlobalPatterns, package = "mia")
+    tse <- GlobalPatterns
+    res <- tse |>
+        subsetBy(cols = colSums(counts) >= 500000) |>
+        transformAssay(method = "relabundance") |>
