@@ -32,6 +32,29 @@ parse_formula <- function(fm) {
 #' Get matrix from tibble
 #'
 #' @import dplyr
+#'
+#' @keywords internal
+#'
+#' @import dplyr
+#' @import tidyr
+#' @importFrom purrr as_mapper
+#'
+#' @param .x A tibble
+#' @param .p A boolean
+#' @param .f1 A function
+#' @param .f2 A function
+#'
+#' @return A tibble
+ifelse_pipe = function(.x, .p, .f1, .f2 = NULL) {
