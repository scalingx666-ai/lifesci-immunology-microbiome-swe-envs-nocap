-ENV CXX=/usr/bin/g++-11
+ENV CC=/usr/bin/gcc-13
+ENV CXX=/usr/bin/g++-13
 
 RUN mkdir -p /opt/metagraph/build_docker /opt/ccache_docker
 RUN chmod o+rwx /opt/metagraph /opt/ccache_docker
