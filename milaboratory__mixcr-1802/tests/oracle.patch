+  limit: null
+  parameters:
+    vParameters:
+      geneFeatureToAlign: VGeneWithP
+      minSumScore: 150
+      relativeMinScore: 0.97
+      maxHits: 5
+      parameters:
+        type: kaligner2
+        mapperNValue: 8
+        mapperKValue: 1
