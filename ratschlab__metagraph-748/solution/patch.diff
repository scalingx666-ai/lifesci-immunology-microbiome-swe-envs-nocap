diff --git a/.github/workflows/linux.yml b/.github/workflows/linux.yml
index 39fd866419..56b44a1cef 100644
--- a/.github/workflows/linux.yml
+++ b/.github/workflows/linux.yml
@@ -72,6 +72,10 @@ jobs:
         run: |
           sudo apt-get update
           if [[ "${{ inputs.compiler }}" != "clang" ]]; then
+              # Ubuntu 24.04 ships GCC up to 14; newer versions come from the toolchain PPA
+              if ! apt-cache show ${{ inputs.compiler }} > /dev/null 2>&1; then
+                  sudo add-apt-repository -y ppa:ubuntu-toolchain-r/test
+              fi
               sudo apt-get install -y ${{ inputs.compiler }}
           fi
           sudo apt-get install -y cmake make libbz2-dev libjemalloc-dev libboost-all-dev libdeflate-dev liblzma-dev libzstd-dev
