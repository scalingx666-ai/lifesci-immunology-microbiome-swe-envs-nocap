-<div class="inner_cell">
-    <div class="input_area">
-<div class=" highlight hl-julia"><pre><span></span><span class="c"># Define time frame, 2 months</span>
-<span class="n">tspan</span> <span class="o">=</span> <span class="p">(</span><span class="mf">0.0</span><span class="p">,</span><span class="mf">60.0</span><span class="p">)</span>
-<span class="c"># Define initial states</span>
-<span class="n">u0</span> <span class="o">=</span> <span class="n">zeros</span><span class="p">(</span><span class="kt">Float64</span><span class="p">,</span> <span class="n">base</span><span class="p">(</span><span class="n">pc_seird_3</span><span class="p">)</span><span class="o">.</span><span class="n">n</span><span class="p">)</span>
-<span class="n">u0</span><span class="p">[</span><span class="mi">1</span><span class="p">]</span>  <span class="o">=</span> <span class="mi">10000</span>
-<span class="n">u0</span><span class="p">[</span><span class="mi">6</span><span class="p">]</span>  <span class="o">=</span> <span class="mi">10000</span>
-<span class="n">u0</span><span class="p">[</span><span class="mi">11</span><span class="p">]</span> <span class="o">=</span> <span class="mi">10000</span>
-<span class="n">u0</span><span class="p">[</span><span class="mi">2</span><span class="p">]</span>  <span class="o">=</span> <span class="mi">1</span>
-<span class="c"># Define transition rates</span>
-<span class="n">seirdparams</span><span class="p">(</span><span class="n">n</span><span class="o">::</span><span class="kt">Int</span><span class="p">,</span> <span class="n">k</span><span class="o">::</span><span class="kt">Number</span><span class="p">)</span> <span class="o">=</span> <span class="k">begin</span>
-    <span class="n">βseird</span> <span class="o">=</span> <span class="p">[</span><span class="mi">10</span><span class="o">/</span><span class="n">sum</span><span class="p">(</span><span class="n">u0</span><span class="p">),</span> <span class="mi">1</span><span class="o">/</span><span class="mi">2</span><span class="p">,</span> <span class="mi">1</span><span class="o">/</span><span class="mi">5</span><span class="p">,</span> <span class="mi">1</span><span class="o">/</span><span class="mi">16</span><span class="p">]</span>
-    <span class="n">βtravel</span> <span class="o">=</span> <span class="p">[</span><span class="mi">1</span><span class="o">/</span><span class="mi">2</span><span class="p">,</span> <span class="mi">1</span><span class="o">/</span><span class="mi">200</span><span class="p">,</span> <span class="mi">1</span><span class="o">/</span><span class="mi">2</span><span class="p">]</span><span class="o">/</span><span class="mi">100</span><span class="n">k</span>
-    <span class="n">β</span> <span class="o">=</span> <span class="n">vcat</span><span class="p">(</span><span class="n">βseird</span><span class="p">,</span> <span class="n">βtravel</span><span class="p">)</span>
-    <span class="k">return</span> <span class="n">foldl</span><span class="p">(</span><span class="n">vcat</span><span class="p">,</span> <span class="p">[</span><span class="n">β</span> <span class="k">for</span> <span class="n">i</span> <span class="kp">in</span> <span class="mi">1</span><span class="o">:</span><span class="n">n</span><span class="p">])</span>
-<span class="k">end</span>
-<span class="n">params</span> <span class="o">=</span> <span class="n">seirdparams</span><span class="p">(</span><span class="mi">3</span><span class="p">,</span> <span class="mi">2</span><span class="p">)</span>
-<span class="c"># Generate and solve resulting ODE</span>
-<span class="n">prob</span> <span class="o">=</span> <span class="n">ODEProblem</span><span class="p">(</span><span class="n">toODE</span><span class="p">(</span><span class="n">p_seird_3</span><span class="p">),</span><span class="n">u0</span><span class="p">,</span><span class="n">tspan</span><span class="p">,</span><span class="n">params</span><span class="p">)</span>
-<span class="n">sol</span> <span class="o">=</span> <span class="n">OrdinaryDiffEq</span><span class="o">.</span><span class="n">solve</span><span class="p">(</span><span class="n">prob</span><span class="p">,</span><span class="n">Tsit5</span><span class="p">())</span>
-<span class="c"># visualize the solution</span>
-<span class="n">plot</span><span class="p">(</span><span class="n">sol</span><span class="p">)</span>
-</pre></div>
