diff --git a/NEWS.md b/NEWS.md
index 96798148..50c8dd07 100644
--- a/NEWS.md
+++ b/NEWS.md
@@ -14,6 +14,7 @@
 -   `netsim()` and `netdx()` with `ncores > 1` now warn when modules or network model formulas refer to global objects or functions from attached packages, which multisession workers do not have, and `?netsim` has a new Parallel Simulation section on making such code self-contained (#1104).
 -   `netsim()` now stops with an error naming the module when a module returns `dat` with an R attribute set on it, which is what happens when magrittr is attached after EpiModel and masks `set_attr()` (#1120).
 -   `dissolution_coefs()` now warns when a duration is at or above 90% of the departure ceiling, `1 / (2 * d.rate - d.rate^2)`, naming the duration, and its error at the ceiling gives the ceiling and points at the duration before `d.rate` (#1138).
+-   `simulate_dat()` passes the installed ergm version to the term initializers through `term.options`, which otherwise read it from disk every time a term is initialized, with identical output (#1146).
 -   EpiModel no longer imports or links to Rcpp. Its one compiled helper, `shiftVec()`, which `delete_vertices()` uses to renumber vertex IDs after departures, is now plain C registered through R's native routine interface (#1140).
 -   `simulate_dat()` reads the edgelist of a tergmLite layer from the state the sampler returns, instead of having tergm build a network that is converted straight back to an edgelist, with identical output (#1145).
 -   Faster bookkeeping on departures and arrivals in tergmLite simulations, with identical output: `remove_node_attr()` and `append_attr()` copy plain attribute vectors in C, `delete_vertices()` renumbers the edgelist in one pass without sorting, and `update_cumulative_edgelist()` matches the current edges to the open partnerships on a pair key instead of a join (#1141).
diff --git a/R/net.mod.simnet.R b/R/net.mod.simnet.R
index 5ac252c7..019f38e4 100644
--- a/R/net.mod.simnet.R
+++ b/R/net.mod.simnet.R
@@ -128,6 +128,7 @@ simulate_dat <- function(dat, at, network = 1L, nsteps = 1L) {
 
   ## determine formula and coefficients; set discordance_fraction in ergm case
   simulation_control <- get_network_control(dat, network, "set.control.tergm")
+  simulation_control <- set_term_version(simulation_control)
   if (nwparam$coef.diss$duration[1] > 1) {
     formula <- ~Form(nwparam$formation) +
       Persist(nwparam$coef.diss$dissolution)
@@ -495,3 +496,24 @@ update_sim_num <- function(dat) {
   }
   return(dat)
 }
+
+
+# Workaround for statnet/ergm#671, to remove with #1148: ergm's term
+# initializers read the ergm version from disk unless it is passed to them
+set_term_version <- function(control) {
+  if (is.null(control$term.options$version)) {
+    control$term.options$version <- ergm_version()
+  }
+  control
+}
+
+# The version of the installed ergm, read once per session
+ergm_version <- local({
+  version <- NULL
+  function() {
+    if (is.null(version)) {
+      version <<- utils::packageVersion("ergm")
+    }
+    version
+  }
+})
diff --git a/tests/testthat/test-ergm-term-version.R b/tests/testthat/test-ergm-term-version.R
new file mode 100644
index 00000000..1fe76b02
--- /dev/null
+++ b/tests/testthat/test-ergm-term-version.R
@@ -0,0 +1,76 @@
+context("ergm term version")
+
+# Tests of the workaround for statnet/ergm#671; they go when it does (#1148)
+
+test_that("set_term_version fills in the installed ergm version", {
+  control <- tergm::control.simulate.formula.tergm()
+  expect_null(control$term.options$version)
+  out <- set_term_version(control)
+  expect_identical(out$term.options$version, utils::packageVersion("ergm"))
+  expect_identical(class(out), class(control))
+  expect_identical(out[names(out) != "term.options"],
+                   control[names(control) != "term.options"])
+})
+
+test_that("set_term_version keeps what the user set", {
+  old <- as.package_version("3.9.4")
+  control <- tergm::control.simulate.formula.tergm(
+    term.options = list(version = old, interact.dependent = "silent")
+  )
+  expect_identical(set_term_version(control), control)
+
+  control <- tergm::control.simulate.formula.tergm(
+    term.options = list(interact.dependent = "silent")
+  )
+  out <- set_term_version(control)
+  expect_identical(out$term.options$interact.dependent, "silent")
+  expect_identical(out$term.options$version, utils::packageVersion("ergm"))
+})
+
+test_that("simulate_dat gives the same network as the default version", {
+  skip_on_cran()
+  set.seed(1)
+  nw <- network_initialize(n = 100)
+  nw <- set_vertex_attribute(nw, "grp", rep(1:2, each = 50))
+  est <- netest(
+    nw,
+    formation = ~edges + nodematch("grp") + nodefactor("grp"),
+    target.stats = c(30, 20, 28),
+    coef.diss = dissolution_coefs(~offset(edges), 10),
+    verbose = FALSE
+  )
+  param <- param.net(inf.prob = 0.3, act.rate = 1)
+  init <- init.net(i.num = 10)
+  control <- control.net(type = "SI", nsteps = 5, nsims = 1, ncores = 1,
+                         tergmLite = TRUE, resimulate.network = TRUE,
+                         verbose = FALSE)
+  crosscheck.net(est, param, init, control)
+  control <- netsim_validate_control(control)
+  dat <- netsim_initialize(est, param, init, control, s = 1)
+  nwparam <- get_nwparam(dat, network = 1)
+
+  set.seed(5)
+  out <- simulate_dat(dat, at = 2L)
+  after <- runif(1)
+  # the same call with the control as the user gave it, no version in it
+  set.seed(5)
+  ref_nw <- suppressWarnings(simulate(
+    ~Form(nwparam$formation) + Persist(nwparam$coef.diss$dissolution),
+    coef = c(nwparam$coef.form, nwparam$coef.diss$coef.adj),
+    basis = get_network(x = dat, network = 1),
+    constraints = nwparam$constraints,
+    time.start = 1L,
+    time.offset = 1L,
+    time.slices = 1L,
+    output = "final",
+    control = get_network_control(dat, 1, "set.control.tergm"),
+    monitor = NULL,
+    dynamic = TRUE
+  ))
+  ref <- set_network(dat, network = 1, nw = ref_nw)
+
+  expect_null(get_network_control(dat, 1, "set.control.tergm")$term.options$version)
+  expect_identical(runif(1), after)
+  expect_identical(out$run$el, ref$run$el)
+  expect_false(identical(out$run$el[[1]], dat$run$el[[1]]))
+})
