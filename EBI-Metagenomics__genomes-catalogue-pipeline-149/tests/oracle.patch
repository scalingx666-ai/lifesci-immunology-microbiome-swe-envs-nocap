+
+
+workflow GENERATE_GTDB_FULL_MSA {
+
+    take:
+        genomes
+        extension
+        reference_db
+    main:
+    
+    GTDBTK_IDENTIFY (
+        genomes,
+        extension,
+        reference_db
+    )
+    
+    GTDBTK_ALIGN (
+        GTDBTK_IDENTIFY.out.gtdbtk_msa_folder,
+        reference_db
+    )
+    
+    BUILD_TAXONOMY_TREES (
