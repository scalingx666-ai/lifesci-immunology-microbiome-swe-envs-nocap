+        GTDBTK_ALIGN.out.gtdbtk_user_msa_ar53,
+        channel.empty(), // iTOL files are generated by the main BUILD_TAXONOMY_TREES call
+        channel.empty(),
+        channel.value("bac120_full"),  // output prefix for bacteria trees
+        channel.value("ar53_full"),    // output prefix for archaea trees
