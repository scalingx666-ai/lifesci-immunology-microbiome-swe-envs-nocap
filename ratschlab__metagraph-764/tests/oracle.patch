+        }
+        if (record.open_next < record.open_end && next_coord(runs[record.open_next]) == coord) {
+            ++runs[record.open_next++].len;
+        } else {
+            runs.push_back({ static_cast<uint32_t>(pos), 1, coord });
+        }
+    }
