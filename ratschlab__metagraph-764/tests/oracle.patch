+                            close_last_run(record.runs);
+                            record.runs.push_back({ static_cast<uint32_t>(pos), 1, 1 });
+                        } else if (values_ == kCounts) {
+                            ++record.runs.back().value;
+                        }
+                        break;
+                    case kCoords:
