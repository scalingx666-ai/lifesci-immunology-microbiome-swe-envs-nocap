+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## IMHE forecasts"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "imhe_covid_19 = [{\n",
+    "    \"table\": \"IMHE_COVID_19\",\n",
+    "    \"description\": \"IMHE COVID-19 forecasts\"\n",
+    "}, {\n",
+    "    \"table\": \"IMHE_COVID_19\",\n",
+    "    \"column\": \"DATE\",\n",
+    "    \"type\": \"DATE\",\n",
+    "    \"description\": \"Date of forecast\",\n",
+    "    \"nullable\": True,\n",
+    "    \"source\": \"IMHE\"\n",
+    "}]"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "imhe_indicators = {\n",
+    "    \"allbed\": \"COVID-19 beds needed on date\",\n",
+    "    \"icubed\": \"Intensive care beds needed on date\",\n",
+    "    \"invven\": \"Invasive ventilation needed on date\",\n",
+    "    \"deaths\": \"Deaths on date\",\n",
+    "    \"admis\": \"Hospital admissions on date\",\n",
+    "    \"newicu\": \"New ICU cases on date\",\n",
+    "    \"totdea\": \"Total deaths on date\",\n",
+    "    \"bedover\": \"Bed overflow on date\",\n",
+    "    \"icuover\": \"ICU bed overflow on date\"\n",
+    "}\n",
+    "\n",
+    "imhe_dimensions = {\n",
+    "    \"mean\": \"mean\",\n",
+    "    \"lower\": \"lower uncertainty bound\",\n",
+    "    \"upper\": \"upper uncertainty bound\"\n",
+    "}\n",
+    "\n",
+    "for i in imhe_indicators:\n",
+    "    for j in imhe_dimensions:\n",
+    "        imhe_covid_19.append({\"table\": \"IMHE_COVID_19\",\n",
+    "                              \"column\": i.upper() + \"_\" + j.upper(),\n",
+    "                              \"type\": \"FLOAT\",\n",
+    "                              \"description\": imhe_indicators[i] + \", \" + imhe_dimensions[j],\n",
+    "                              \"nullable\": True,\n",
+    "                              \"source\": \"IMHE\"})"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "imhe_covid_19 += [{\n",
+    "    \"table\": \"IMHE_COVID_19\",\n",
+    "    \"column\": \"LAST_UPDATED_DATE\",\n",
+    "    \"type\": ts,\n",
+    "    \"description\": \"Timestamp of last update\",\n",
+    "    \"nullable\": False,\n",
+    "}, {\n",
+    "    \"table\": \"IMHE_COVID_19\",\n",
+    "    \"column\": \"LAST_REPORTED_FLAG\",\n",
+    "    \"type\": \"BOOLEAN\",\n",
+    "    \"description\":\n",
+    "    \"TRUE if new data reported in the last update, otherwise FALSE\",\n",
+    "    \"nullable\": True\n",
+    "}, {\n",
+    "    \"table\": \"IMHE_COVID_19\",\n",
+    "    \"column\": \"COUNTRY_REGION\",\n",
+    "    \"type\": varchar_small,\n",
+    "    \"description\": \"ISO 3166-1 entity name\",\n",
