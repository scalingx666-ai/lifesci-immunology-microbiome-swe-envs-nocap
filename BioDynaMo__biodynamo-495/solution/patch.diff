diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9f81d9760..b7032bc24 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -253,6 +253,12 @@ else()
          "eval \"$(pyenv init -)\" \n"
          "pyenv shell ${pythonvers}")
    endif()
+   # ParaView/VTK call find_package(Python3 ...) internally, unconstrained by
+   # version. Pin it to the same pyenv interpreter found above so it doesn't
+   # discover a newer system Python instead (e.g. Ubuntu 26.04 ships Python
+   # 3.14 by default, without its -dev headers installed).
+   set(Python3_EXECUTABLE ${Python_EXECUTABLE} CACHE FILEPATH
+       "Pin ParaView/VTK's Python3 lookup to the pyenv interpreter" FORCE)
 endif()
 
 # Check if OpenMPI is present
diff --git a/cmake/utils.cmake b/cmake/utils.cmake
index 9a6a22549..7085fca84 100644
--- a/cmake/utils.cmake
+++ b/cmake/utils.cmake
@@ -411,7 +411,7 @@ function(BuildParaViewPlugin)
   add_custom_command(
     OUTPUT ${CMAKE_INSTALL_PVPLUGINDIR}/BDMGlyphFilter.so ${CMAKE_INSTALL_ROOT}/lib/libBDM.${PLUG_LIB_XTENSION}
     WORKING_DIRECTORY ${CMAKE_BDM_PVPLUGINDIR}
-    COMMAND ${LAUNCHER} ${CMAKE_COMMAND} -B "${BDM_PVPLUGIN_BUILDDIR}"
+    COMMAND ${LAUNCHER} ${CMAKE_COMMAND} -B "${BDM_PVPLUGIN_BUILDDIR}" -DPython3_EXECUTABLE=${Python3_EXECUTABLE}
     COMMAND ${LAUNCHER} ${CMAKE_COMMAND} --build "${BDM_PVPLUGIN_BUILDDIR}"
     COMMAND ${CMAKE_COMMAND} -E copy "${BDM_PVPLUGIN_BUILDDIR}/lib/paraview-${CMAKE_BDM_PVVERSION}/plugins/BDMGlyphFilter/BDMGlyphFilter.so" "${CMAKE_INSTALL_PVPLUGINDIR}"
     COMMAND ${CMAKE_COMMAND} -E copy "${BDM_PVPLUGIN_BUILDDIR}/lib/paraview-${CMAKE_BDM_PVVERSION}/plugins/BDMGlyphFilter/libBDM.${PLUG_LIB_XTENSION}" "${CMAKE_INSTALL_ROOT}/lib"
