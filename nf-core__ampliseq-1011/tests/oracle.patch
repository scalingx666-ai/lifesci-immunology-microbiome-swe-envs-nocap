+                } else if ( params.ignore_binned_quality && !params.binned_quality && it.size() < 6 ) {
+                    log.warn "Over all samples, ${it.size()} $it distinct quality scores were found. Quality scores seem binned!\nThe issue is ignored"
+                }
+            }
     }
 
