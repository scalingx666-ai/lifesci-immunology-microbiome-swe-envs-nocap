diff --git a/metagraph/src/graph/annotation_key_mapper.cpp b/metagraph/src/graph/annotation_key_mapper.cpp
new file mode 100644
index 0000000000..5b12caac20
--- /dev/null
+++ b/metagraph/src/graph/annotation_key_mapper.cpp
@@ -0,0 +1,44 @@
+#include "annotation_key_mapper.hpp"
+
+#include <algorithm>
+#include <cassert>
+#include <stdexcept>
+
+#include "representation/canonical_dbg.hpp"
+
+namespace mtg::graph {
+
+AnnotationKeyMapper::AnnotationKeyMapper(const DeBruijnGraph &graph)
+      : graph_(graph), mode_(graph.get_mode()),
+        canonical_(dynamic_cast<const CanonicalDBG*>(&graph)) {
+    if (mode_ == DeBruijnGraph::PRIMARY)
+        throw std::invalid_argument("Wrap PRIMARY graphs in CanonicalDBG before mapping annotations");
+}
+
+auto AnnotationKeyMapper::canonical_key(node_index node, std::string_view kmer) const -> node_index {
+    if (canonical_)
+        return canonical_->get_base_node(node);
+    assert(kmer.size() == graph_.get_k());
+    node_index result = DeBruijnGraph::npos;
+    graph_.map_to_nodes(kmer, [&](node_index key) { result = key; });
+    return result;
+}
+
+auto AnnotationKeyMapper::keys(std::span<const node_index> nodes,
+                                std::string_view sequence) const -> std::vector<node_index> {
+    if (nodes.empty())
+        return {};
+    std::vector<node_index> result(nodes.size());
+    if (needs_sequence()) {
+        assert(sequence.size() == nodes.size() + graph_.get_k() - 1);
+        size_t i = 0;
+        graph_.map_to_nodes(sequence, [&](node_index key) { result[i++] = key; });
+        assert(i == nodes.size());
+    } else {
+        std::transform(nodes.begin(), nodes.end(), result.begin(),
+                       [&](node_index node) { return key(node); });
+    }
+    return result;
+}
+
+} // namespace mtg::graph
diff --git a/metagraph/src/graph/annotation_key_mapper.hpp b/metagraph/src/graph/annotation_key_mapper.hpp
new file mode 100644
index 0000000000..84a98a327f
--- /dev/null
+++ b/metagraph/src/graph/annotation_key_mapper.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <span>
+#include <string_view>
+#include <vector>
+
+#include "representation/base/sequence_graph.hpp"
+
+namespace mtg::graph {
+
+class CanonicalDBG;
+
+// Map oriented graph nodes to the node IDs whose rows carry their annotation.
+// IDs remain one-based here; AnnotatedDBG::graph_to_anno_index converts to rows.
+class AnnotationKeyMapper {
+  public:
+    using node_index = DeBruijnGraph::node_index;
+    explicit AnnotationKeyMapper(const DeBruijnGraph &graph);
+
+    bool needs_sequence() const {
+        return mode_ == DeBruijnGraph::CANONICAL && !canonical_;
+    }
+    // For a nonzero node, supply its k-mer spelling when needs_sequence() is true.
+    node_index key(node_index node, std::string_view kmer = {}) const {
+        if (!node || mode_ == DeBruijnGraph::BASIC)
+            return node;
+        return canonical_key(node, kmer);
+    }
+    // Supply the path's spelling when needs_sequence() is true. Missing nodes
+    // retain npos, and returned keys correspond to the input positions.
+    std::vector<node_index> keys(std::span<const node_index> nodes,
+                                 std::string_view sequence = {}) const;
+
+  private:
+    node_index canonical_key(node_index node, std::string_view kmer) const;
+    const DeBruijnGraph &graph_;
+    DeBruijnGraph::Mode mode_;
+    const CanonicalDBG *canonical_;
+};
+
+} // namespace mtg::graph
diff --git a/metagraph/tests/graph/test_annotation_key_mapper.cpp b/metagraph/tests/graph/test_annotation_key_mapper.cpp
new file mode 100644
index 0000000000..c8f1a2aa88
--- /dev/null
+++ b/metagraph/tests/graph/test_annotation_key_mapper.cpp
@@ -0,0 +1,79 @@
+#include <gtest/gtest.h>
+
+#include "all/test_dbg_helpers.hpp"
+#include "common/seq_tools/reverse_complement.hpp"
+#include "graph/annotation_key_mapper.hpp"
+#include "graph/representation/canonical_dbg.hpp"
+
+
+namespace {
+
+using namespace mtg;
+using namespace mtg::graph;
+using namespace mtg::test;
+
+const std::string kSequence = "ATGCGATCGATTAGCCATGCGATTCAGGCAT";
+
+TEST(AnnotationKeyMapper, BasicKeysAreNodes) {
+    auto graph = build_graph_batch<DBGSuccinct>(5, { kSequence }, DeBruijnGraph::BASIC);
+    AnnotationKeyMapper mapper(*graph);
+    ASSERT_FALSE(mapper.needs_sequence());
+
+    auto path = map_to_nodes_sequentially(*graph, kSequence);
+    EXPECT_EQ(path, mapper.keys(path));
+}
+
+#if ! _PROTEIN_GRAPH
+// Primary and canonical graphs need reverse complements, which proteins lack.
+// The test helper returns primary graphs wrapped in CanonicalDBG
+const CanonicalDBG& wrapped_primary(const std::shared_ptr<DeBruijnGraph> &graph) {
+    const auto *canonical = dynamic_cast<const CanonicalDBG*>(graph.get());
+    EXPECT_TRUE(canonical);
+    return *canonical;
+}
+
+TEST(AnnotationKeyMapper, PrimaryGraphMustBeWrapped) {
+    auto graph = build_graph_batch<DBGSuccinct>(5, { kSequence }, DeBruijnGraph::PRIMARY);
+    const DeBruijnGraph &primary = wrapped_primary(graph).get_graph();
+    ASSERT_EQ(DeBruijnGraph::PRIMARY, primary.get_mode());
+    EXPECT_THROW(AnnotationKeyMapper mapper(primary), std::invalid_argument);
+}
+
+// A k-mer and its reverse complement carry the same annotation row, so their
+// keys must coincide, in reverse order along the path.
+void check_reverse_complement_keys(const DeBruijnGraph &graph) {
+    AnnotationKeyMapper mapper(graph);
+
+    std::string rc = kSequence;
+    reverse_complement(rc.begin(), rc.end());
+
+    auto path = map_to_nodes_sequentially(graph, kSequence);
+    auto rc_path = map_to_nodes_sequentially(graph, rc);
+    ASSERT_EQ(path.size(), rc_path.size());
+
+    auto keys = mapper.keys(path, mapper.needs_sequence() ? kSequence : "");
+    auto rc_keys = mapper.keys(rc_path, mapper.needs_sequence() ? rc : "");
+    std::reverse(rc_keys.begin(), rc_keys.end());
+    EXPECT_EQ(keys, rc_keys);
+    EXPECT_EQ(keys.end(), std::find(keys.begin(), keys.end(), DeBruijnGraph::npos));
+
+    for (size_t i = 0; i < path.size(); ++i) {
+        EXPECT_EQ(keys[i], mapper.key(path[i], std::string_view(kSequence).substr(i, graph.get_k())));
+    }
+}
+
+TEST(AnnotationKeyMapper, CanonicalGraphMapsBothStrandsToOneKey) {
+    auto graph = build_graph_batch<DBGSuccinct>(5, { kSequence }, DeBruijnGraph::CANONICAL);
+    ASSERT_TRUE(AnnotationKeyMapper(*graph).needs_sequence());
+    check_reverse_complement_keys(*graph);
+}
+
+TEST(AnnotationKeyMapper, WrappedPrimaryGraphMapsBothStrandsToOneKey) {
+    auto primary = build_graph_batch<DBGSuccinct>(5, { kSequence }, DeBruijnGraph::PRIMARY);
+    const CanonicalDBG &graph = wrapped_primary(primary);
+    ASSERT_FALSE(AnnotationKeyMapper(graph).needs_sequence());
+    check_reverse_complement_keys(graph);
+}
+#endif
+
+} // namespace
