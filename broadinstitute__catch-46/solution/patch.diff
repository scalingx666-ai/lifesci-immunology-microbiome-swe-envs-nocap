+    """
+    d = {'sets': sets,
+            'costs': costs,
+            'universe_p': universe_p,
+            'ranks': ranks}
+    tf_name = None
+    with tempfile.NamedTemporaryFile(delete=False) as tf:
+        pickle.dump(d, tf)
+        tf.flush()
+        tf_name = tf.name
+    return tf_name
+
