+rates(p::AbstractPetriNet) = begin
+  if has_subpart(p, :tname)
+    tnames = [tname(p, s) for s in 1:nt(p)]
+    LVector(; [(tnames[t] => rate(p, t)) for t in 1:nt(p)]...)
+  else
+    return map(t -> rate(p, t), 1:nt(p))
+  end
