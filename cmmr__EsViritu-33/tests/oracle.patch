+                covered_bases = sum(1 for d in coverage if d > 0)
+                if covered_bases == 0:
+                    avg_cov = 0.0
+                else:
+                    avg_cov = float(sum(coverage)) / window_length if window_length > 0 else 0.0
+                records.append({
