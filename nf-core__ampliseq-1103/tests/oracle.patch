diff --git a/tests/savont_incompatible.nf.test b/tests/savont_incompatible.nf.test
new file mode 100644
index 000000000..cb3edf09d
--- /dev/null
+++ b/tests/savont_incompatible.nf.test
@@ -0,0 +1,23 @@
+nextflow_pipeline {
+
+    name "Test pipeline"
+    script "../main.nf"
+    tag "pipeline"
+
+    test("-profile test --asv_calling savont fails with paired end data") {
+
+        when {
+            params {
+                outdir = "$outputDir"
+                asv_calling = "savont"
+            }
+        }
+
+        then {
+            assertAll(
+                { assert workflow.failed },
+                { assert workflow.stdout.any { it.contains("requires single end data") } || workflow.stderr.any { it.contains("requires single end data") } }
+            )
+        }
+    }
+}
