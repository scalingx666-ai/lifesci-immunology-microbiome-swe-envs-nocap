u043c\u043f\u0442\u043e\u043c\u044b? \u0412\u0430\u0441 \u0437\u043d\u043e\u0431\u0438\u0442?", "shortnessOfBreath": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435?", "fatigue": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0423\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u044c?", "dryCough": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0421\u0443\u0445\u043e\u0439 \u043a\u0430\u0448\u0435\u043b\u044c?", "soreThroat": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0411\u043e\u043b\u0438\u0442 \u043b\u0438 \u0433\u043e\u0440\u043b\u043e?", "bluishLipsOrFace": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u041f\u043e\u0441\u0438\u043d\u0435\u0432\u0448\u0438\u0435 \u0433\u0443\u0431\u044b \u0438\u043b\u0438 \u043b\u0438\u0446\u043e?", "gastrointestinalIssuesExamplesNauseaDiarrheaVomitingAbdominalPain": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u044b\u043c \u0442\u0440\u0430\u043a\u0442\u043e\u043c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u043f\u043e\u043d\u043e\u0441, \u0431\u043e\u043b\u044c \u0432 \u0436\u0438\u0432\u043e\u0442\u0435)?", "headache": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0413\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c?", "lostSenseOfSmell": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u041f\u043e\u0442\u0435\u0440\u044f \u043e\u0431\u043e\u043d\u044f\u043d\u0438\u044f \u0438 \u0432\u043a\u0443\u0441\u0430?", "diarrhea": ""}, "temperature": {"array": ["\u041a\u0430\u043a\u0430\u044f\u0443 \u0432\u0430\u0441 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430?"], "whatIsYourTemperatureReadingToday": "\u041a\u0430\u043a\u0430\u044f \u0443 \u0432\u0430\u0441 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430?"}}}, "education": {"current_events": {"fact": {"array": ["", "", ""], "reportsPetsHave": "", "sarscov2UnitedReported": "", "seattleBiotechBased": ""}}, "public_health": {"fact": {"array": ["\u0412\u0438\u0440\u0443\u0441,\u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u043d\u0443\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c 2019 \u0433\u043e\u0434\u0430 (\u041a\u041e\u0412\u0418\u0414-19), \u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u043a\u043e\u0440\u043e\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u044b\u0447\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u043e\u043d\u044f\u044e\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \u043b\u044e\u0434\u0435\u0439 \u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u043b\u0435\u0433\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0443).", "\u0425\u043e\u0442\u044f\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e SARS-CoV-2 \u0432\u043e\u0437\u043d\u0438\u043a \u043d\u0430 \u0440\u044b\u043d\u043a\u0435 \u0434\u0438\u043a\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445 \u0432 \u0423\u0445\u0430\u043d\u0435, \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u044b\u043c \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u043e\u043c \u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u0438\u043c.  \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0441 \u0441\u044b\u0440\u044b\u043c \u043c\u044f\u0441\u043e\u043c, \u043c\u043e\u043b\u043e\u043a\u043e\u043c \u0438\u043b\u0438 \u043e\u0440\u0433\u0430\u043d\u0430\u043c\u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445.  \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u044b \u043f\u0435\u0440\u0435\u0434 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\u043c.  (\u0412\u041e\u0417)", "\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043f\u043e\u0441\u044b\u043b\u043a\u0438 \u0438\u0437 \u0440\u0430\u0439\u043e\u043d\u043e\u0432, \u0433\u0434\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u043b\u043e\u0441\u044c \u043e COVID-19. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u043e\u0432\u0430\u0440\u0430 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u043d\u0438\u0437\u043a\u0430, \u0430 \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u043c COVID-19, \u0438\u0437 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430, \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u0430 \u0438 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u043b\u0430\u0441\u044c \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u0442\u0430\u043a\u0436\u0435 \u043d\u0438\u0437\u043a\u0430. (\u0412\u041e\u0417)", "\u041b\u0438\u0446\u0430\u0441\u0442\u0430\u0440\u0448\u0435 65 \u043b\u0435\u0442 \u0438 \u0432\u0441\u0435 \u043b\u044e\u0434\u0438 \u0441 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u043b\u0435\u0433\u043a\u0438\u0445, \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0438\u043b\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0430\u0441\u0442\u043c\u043e\u0439, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0435\u0440\u0434\u0446\u0430, \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u043e\u0447\u0435\u043a, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0441 \u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u044b\u043c \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u043e\u043c \u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u044b COVID-19. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043c\u043e\u043b\u043e\u0434\u044b\u0435 \u043b\u044e\u0434\u0438 \u0432\u0441\u0435 \u0435\u0449\u0435 \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u0431\u043e\u043b\u0435\u0442\u044c. (\u0412\u041e\u0417)", "\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435\u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 COVID-19 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u044c \u0438 \u0441\u0443\u0445\u043e\u0439 \u043a\u0430\u0448\u0435\u043b\u044c. \u0423 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u0438, \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u043e\u0441\u0430, \u043d\u0430\u0441\u043c\u043e\u0440\u043a, \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438\u043b\u0438 \u0434\u0438\u0430\u0440\u0435\u044f. \u042d\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043e\u0431\u044b\u0447\u043d\u043e \u0441\u043b\u0430\u0431\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u044b \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0434\u0438 \u0437\u0430\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f, \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e\u0442 \u0441\u0435\u0431\u044f \u043f\u043b\u043e\u0445\u043e. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439 (\u043e\u043a\u043e\u043b\u043e 80%) \u0432\u044b\u0437\u0434\u043e\u0440\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442 \u043e\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0431\u0435\u0437 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f. (\u0412\u041e\u0417)", "COVID-19\u0431\u043e\u043b\u0435\u0435 \u0441\u0435\u0440\u044c\u0435\u0437\u0435\u043d, \u0447\u0435\u043c \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u0439 \u0433\u0440\u0438\u043f\u043f \u043f\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c. \u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0434\u043b\u0438\u043d\u043d\u0435\u0435, \u043e\u043d \u043d\u043e\u0432\u044b\u0439 \u0434\u043b\u044f \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442, \u0432\u044b, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u0435 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439, \u0447\u0435\u043c \u0433\u0440\u0438\u043f\u043f\u043e\u043c, \u0438 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u0448\u0435. (CDC)", "\u041f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e1 \u0438\u0437 \u043a\u0430\u0436\u0434\u044b\u0445 6 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u044e\u0449\u0438\u0445 COVID-19, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u0431\u043e\u043b\u0435\u0435\u0442 \u0438 \u0438\u043c\u0435\u0435\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0434\u044b\u0445\u0430\u043d\u0438\u0435\u043c. \u041f\u043e\u0436\u0438\u043b\u044b\u0435 \u043b\u044e\u0434\u0438 \u0438 \u0442\u0435, \u0443 \u043a\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0432\u044b\u0441\u043e\u043a\u043e\u0435 \u043a\u0440\u043e\u0432\u044f\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0441\u0435\u0440\u0434\u0446\u0435\u043c \u0438\u043b\u0438 \u0434\u0438\u0430\u0431\u0435\u0442, \u0431\u043e\u043b\u0435\u0435 \u0441\u043a\u043b\u043e\u043d\u043d\u044b \u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439. \u041b\u044e\u0434\u0438 \u0441 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u043e\u0439, \u043a\u0430\u0448\u043b\u0435\u043c \u0438 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u043d\u044b\u043c \u0434\u044b\u0445\u0430\u043d\u0438\u0435\u043c \u0434\u043e\u043b\u0436\u043d\u044b \u043e\u0431\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u044c\u044e. (\u0412\u041e\u0417)", "COVID-19\u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0441 \u043b\u0435\u0433\u043a\u0438\u043c\u0438 \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f. \u0411\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0434\u0435\u043b\u0430\u0435\u0442 COVID-19 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043e\u043f\u0430\u0441\u043d\u044b\u043c \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438. \u0412\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a \u0432\u0430\u0436\u043d\u043e \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u0442\u0435\u0441\u043d\u044b\u0445 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u0438 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0433\u0438\u0433\u0438\u0435\u043d\u0443, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441\u0435\u0431\u044f \u043f\u043b\u043e\u0445\u043e. (\u0412\u041e\u0417)", "SARS-CoV-2\u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u043f\u0435\u043b\u044c\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0432\u043e\u0437\u0434\u0443\u0445\u0435 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0440\u0438\u0441\u043a \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u043f\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0443 \u043d\u0438\u0437\u043e\u043a \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 2 \u043c\u0435\u0442\u0440\u043e\u0432. (\u0412\u041e\u0417)", "\u0412\u0430\u0448\u0430\u0446\u0435\u043b\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u043c COVID-19, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f \u043e\u0442 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u044b \u0431\u0443\u0434\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c, \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0442 \u0438\u043c \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c!", "\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u0432\u044f\u0437\u044c \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0441\u0432\u044f\u0437\u0438. \u041f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u0434\u043e\u043c\u0435 \u0443 \u0432\u0430\u0448\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430 - \u044d\u0442\u043e \u043d\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u044f!", "\u0427\u0430\u0441\u0442\u043e\u043c\u043e\u0439\u0442\u0435 \u0440\u0443\u043a\u0438 \u0441 \u043c\u044b\u043b\u043e\u043c \u0438 \u0432\u043e\u0434\u043e\u0439 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 20 \u0441\u0435\u043a\u0443\u043d\u0434, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430 \u0441 \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0442\u0440\u043e\u043d\u0443\u0442\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\u044e, \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u0434\u0432\u0435\u0440\u043d\u0430\u044f \u0440\u0443\u0447\u043a\u0430 \u0438\u043b\u0438 \u043a\u043d\u043e\u043f\u043a\u0430 \u043b\u0438\u0444\u0442\u0430. \u041c\u044b\u0442\u044c\u0435 \u0440\u0443\u043a \u0440\u0430\u0441\u0449\u0435\u043f\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0443\u0441 \u043d\u0430 \u0447\u0430\u0441\u0442\u0438, \u0435\u0441\u043b\u0438 \u0432\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e.", "\u041d\u0435\u043f\u0440\u0438\u043a\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044c \u043a \u043b\u0438\u0446\u0443 \u043d\u0435\u043c\u044b\u0442\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438.", "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435\u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0440\u0443\u043a \u043d\u0430 \u0441\u043f\u0438\u0440\u0442\u043e\u0432\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435, \u0435\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043c\u044b\u0442\u044c \u0440\u0443\u043a\u0438. \u0412\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0443\u043a\u0438 \u0434\u043e \u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430, \u0442\u0430\u043a\u043e\u0433\u043e \u043a\u0430\u043a \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d. (\u0412\u041e\u0417)", "\u0427\u0438\u0445\u0430\u0439\u0442\u0435\u0432 \u043b\u043e\u043a\u043e\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u043e \u0440\u0443\u043a\u0438. \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u043f\u0435\u043b\u044c \u0432 \u043c\u0435\u0441\u0442\u0430, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u043c\u043e\u0433\u0443\u0442 \u0441 \u043d\u0438\u043c\u0438 \u0441\u0432\u044f\u0437\u0430\u0442\u044c\u0441\u044f. (\u0412\u041e\u0417)", "\u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c\u0434\u043e\u043c\u0430, \u0435\u0441\u043b\u0438 \u0432\u0430\u043c \u043f\u043b\u043e\u0445\u043e! \u0415\u0441\u043b\u0438 \u0432\u044b \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0435\u0442\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b COVID-19, \u043f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u043b\u0435\u0447\u0430\u0449\u0435\u043c\u0443 \u0432\u0440\u0430\u0447\u0443, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043a\u043b\u0438\u043d\u0438\u043a\u0438. \u0412\u0430\u0448 \u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 COVID-19 \u0432 \u0432\u0430\u0448\u0435\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0435. \u0412\u044b, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0432\u043e\u0439\u0434\u0435\u0442\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 COVID-19 \u0432 \u043a\u043b\u0438\u043d\u0438\u043a\u0435, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435 \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c. (\u0412\u041e\u0417)", "\u041c\u0430\u0441\u043a\u0438\u0434\u043b\u044f \u043b\u0438\u0446\u0430 \u043b\u0443\u0447\u0448\u0435 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442 \u0432\u0438\u0440\u0443\u0441, \u0447\u0435\u043c \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u044e\u0442 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044e. \u0412\u041e\u0417 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u043d\u043e\u0441\u0438\u0442\u044c \u043c\u0430\u0441\u043a\u0443, \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0432\u044b \u0431\u043e\u043b\u0435\u0435\u0442\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 COVID-19 \u0438\u043b\u0438 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0435 \u0437\u0430 \u043a\u0435\u043c-\u0442\u043e \u0441 COVID-19. \u0412 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435 \u043e\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u0441\u043a\u0438 \u043f\u043e \u043c\u0435\u0440\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438."], "virusCoronavirusCausing": "\u0412\u0438\u0440\u0443\u0441, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u043d\u0443\u044e \u0431\u043e\u043b\u0435\u0437\u043d\u044c 2019 \u0433\u043e\u0434\u0430 (\u041a\u041e\u0412\u0418\u0414-19), \u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u043a\u043e\u0440\u043e\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u044b\u0447\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u043e\u043d\u044f\u044e\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \u043b\u044e\u0434\u0435\u0439 \u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u043b\u0435\u0433\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0443).", "sarscov2MarketOriginated": "\u0425\u043e\u0442\u044f \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e SARS-CoV-2 \u0432\u043e\u0437\u043d\u0438\u043a \u043d\u0430 \u0440\u044b\u043d\u043a\u0435 \u0434\u0438\u043a\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445 \u0432 \u0423\u0445\u0430\u043d\u0435, \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u044b\u043c \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u043e\u043c \u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u0438\u043c.  \u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0441 \u0441\u044b\u0440\u044b\u043c \u043c\u044f\u0441\u043e\u043c, \u043c\u043e\u043b\u043e\u043a\u043e\u043c \u0438\u043b\u0438 \u043e\u0440\u0433\u0430\u043d\u0430\u043c\u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445.  \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u044b \u043f\u0435\u0440\u0435\u0434 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\u043c.  (\u0412\u041e\u0417)", "packagesAreasIs": "\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043f\u043e\u0441\u044b\u043b\u043a\u0438 \u0438\u0437 \u0440\u0430\u0439\u043e\u043d\u043e\u0432, \u0433\u0434\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u043b\u043e\u0441\u044c \u043e COVID-19. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u043e\u0432\u0430\u0440\u0430 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c \u043d\u0438\u0437\u043a\u0430, \u0430 \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u043c COVID-19, \u0438\u0437 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430, \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u0430 \u0438 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u043b\u0430\u0441\u044c \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u0442\u0430\u043a\u0436\u0435 \u043d\u0438\u0437\u043a\u0430. (\u0412\u041e\u0417)", "individualsAgeAre": "\u041b\u0438\u0446\u0430 \u0441\u0442\u0430\u0440\u0448\u0435 65 \u043b\u0435\u0442 \u0438 \u0432\u0441\u0435 \u043b\u044e\u0434\u0438 \u0441 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u043b\u0435\u0433\u043a\u0438\u0445, \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0438\u043b\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0430\u0441\u0442\u043c\u043e\u0439, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0435\u0440\u0434\u0446\u0430, \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u043e\u0447\u0435\u043a, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0441 \u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u044b\u043c \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u043e\u043c \u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u044b COVID-19. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043c\u043e\u043b\u043e\u0434\u044b\u0435 \u043b\u044e\u0434\u0438 \u0432\u0441\u0435 \u0435\u0449\u0435 \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u0431\u043e\u043b\u0435\u0442\u044c. (\u0412\u041e\u0417)", "symptomsCovid19Are": "\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 COVID-19 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u044c \u0438 \u0441\u0443\u0445\u043e\u0439 \u043a\u0430\u0448\u0435\u043b\u044c. \u0423 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u0438, \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u043e\u0441\u0430, \u043d\u0430\u0441\u043c\u043e\u0440\u043a, \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438\u043b\u0438 \u0434\u0438\u0430\u0440\u0435\u044f. \u042d\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043e\u0431\u044b\u0447\u043d\u043e \u0441\u043b\u0430\u0431\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u044b \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0434\u0438 \u0437\u0430\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f, \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e\u0442 \u0441\u0435\u0431\u044f \u043f\u043b\u043e\u0445\u043e. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439 (\u043e\u043a\u043e\u043b\u043e 80%) \u0432\u044b\u0437\u0434\u043e\u0440\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442 \u043e\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0431\u0435\u0437 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f. (\u0412\u041e\u0417)", "covid19FluIs": "COVID-19 \u0431\u043e\u043b\u0435\u0435 \u0441\u0435\u0440\u044c\u0435\u0437\u0435\u043d, \u0447\u0435\u043c \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u0439 \u0433\u0440\u0438\u043f\u043f \u043f\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c. \u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0434\u043b\u0438\u043d\u043d\u0435\u0435, \u043e\u043d \u043d\u043e\u0432\u044b\u0439 \u0434\u043b\u044f \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u043b \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442, \u0432\u044b, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u0435 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439, \u0447\u0435\u043c \u0433\u0440\u0438\u043f\u043f\u043e\u043c, \u0438 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u0448\u0435. (CDC)", "peopleCovid19Gets": "\u041f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e 1 \u0438\u0437 \u043a\u0430\u0436\u0434\u044b\u0445 6 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u044e\u0449\u0438\u0445 COVID-19, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e \u0431\u043e\u043b\u0435\u0435\u0442 \u0438 \u0438\u043c\u0435\u0435\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0434\u044b\u0445\u0430\u043d\u0438\u0435\u043c. \u041f\u043e\u0436\u0438\u043b\u044b\u0435 \u043b\u044e\u0434\u0438 \u0438 \u0442\u0435, \u0443 \u043a\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435\u043c, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0432\u044b\u0441\u043e\u043a\u043e\u0435 \u043a\u0440\u043e\u0432\u044f\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0441\u0435\u0440\u0434\u0446\u0435\u043c \u0438\u043b\u0438 \u0434\u0438\u0430\u0431\u0435\u0442, \u0431\u043e\u043b\u0435\u0435 \u0441\u043a\u043b\u043e\u043d\u043d\u044b \u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044e \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439. \u041b\u044e\u0434\u0438 \u0441 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u043e\u0439, \u043a\u0430\u0448\u043b\u0435\u043c \u0438 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u043d\u044b\u043c \u0434\u044b\u0445\u0430\u043d\u0438\u0435\u043c \u0434\u043e\u043b\u0436\u043d\u044b \u043e\u0431\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u044c\u044e. (\u0412\u041e\u0417)", "covid19PeopleBe": "COVID-19 \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0441 \u043b\u0435\u0433\u043a\u0438\u043c\u0438 \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f. \u0411\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0434\u0435\u043b\u0430\u0435\u0442 COVID-19 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043e\u043f\u0430\u0441\u043d\u044b\u043c \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438. \u0412\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a \u0432\u0430\u0436\u043d\u043e \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u0442\u0435\u0441\u043d\u044b\u0445 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u0438 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0433\u0438\u0433\u0438\u0435\u043d\u0443, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441\u0435\u0431\u044f \u043f\u043b\u043e\u0445\u043e. (\u0412\u041e\u0417)", "sarscov2RespiratoryIs": "SARS-CoV-2 \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u043f\u0435\u043b\u044c\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0432\u043e\u0437\u0434\u0443\u0445\u0435 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0440\u0438\u0441\u043a \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u043f\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0443 \u043d\u0438\u0437\u043e\u043a \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 2 \u043c\u0435\u0442\u0440\u043e\u0432. (\u0412\u041e\u0417)", "goalCovid19Be": "\u0412\u0430\u0448\u0430 \u0446\u0435\u043b\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u043c COVID-19, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c \u0441\u0435\u0431\u044f \u043e\u0442 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u044b \u0431\u0443\u0434\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c, \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0442 \u0438\u043c \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c!", "contactFriendsKeep": "\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0432\u044f\u0437\u044c \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0441\u0432\u044f\u0437\u0438. \u041f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u0434\u043e\u043c\u0435 \u0443 \u0432\u0430\u0448\u0435\u0433\u043e \u0434\u0440\u0443\u0433\u0430 - \u044d\u0442\u043e \u043d\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u044f!", "handsSoapWash": "\u0427\u0430\u0441\u0442\u043e \u043c\u043e\u0439\u0442\u0435 \u0440\u0443\u043a\u0438 \u0441 \u043c\u044b\u043b\u043e\u043c \u0438 \u0432\u043e\u0434\u043e\u0439 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 20 \u0441\u0435\u043a\u0443\u043d\u0434, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430 \u0441 \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0442\u0440\u043e\u043d\u0443\u0442\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\u044e, \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u0434\u0432\u0435\u0440\u043d\u0430\u044f \u0440\u0443\u0447\u043a\u0430 \u0438\u043b\u0438 \u043a\u043d\u043e\u043f\u043a\u0430 \u043b\u0438\u0444\u0442\u0430. \u041c\u044b\u0442\u044c\u0435 \u0440\u0443\u043a \u0440\u0430\u0441\u0449\u0435\u043f\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0443\u0441 \u043d\u0430 \u0447\u0430\u0441\u0442\u0438, \u0435\u0441\u043b\u0438 \u0432\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e.", "avoidFaceTouching": "\u041d\u0435 \u043f\u0440\u0438\u043a\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044c \u043a \u043b\u0438\u0446\u0443 \u043d\u0435\u043c\u044b\u0442\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438.", "useAlcoholBased": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0440\u0443\u043a \u043d\u0430 \u0441\u043f\u0438\u0440\u0442\u043e\u0432\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435, \u0435\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043c\u044b\u0442\u044c \u0440\u0443\u043a\u0438. \u0412\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0443\u043a\u0438 \u0434\u043e \u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430, \u0442\u0430\u043a\u043e\u0433\u043e \u043a\u0430\u043a \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d. (\u0412\u041e\u0417)", "sneezeHandPrevents": "\u0427\u0438\u0445\u0430\u0439\u0442\u0435 \u0432 \u043b\u043e\u043a\u043e\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u043e \u0440\u0443\u043a\u0438. \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u043f\u0435\u043b\u044c \u0432 \u043c\u0435\u0441\u0442\u0430, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u043c\u043e\u0433\u0443\u0442 \u0441 \u043d\u0438\u043c\u0438 \u0441\u0432\u044f\u0437\u0430\u0442\u044c\u0441\u044f. (\u0412\u041e\u0417)", "stayHomeFeel": "\u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u0434\u043e\u043c\u0430, \u0435\u0441\u043b\u0438 \u0432\u0430\u043c \u043f\u043b\u043e\u0445\u043e! \u0415\u0441\u043b\u0438 \u0432\u044b \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0435\u0442\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b COVID-19, \u043f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u043b\u0435\u0447\u0430\u0449\u0435\u043c\u0443 \u0432\u0440\u0430\u0447\u0443, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043a\u043b\u0438\u043d\u0438\u043a\u0438. \u0412\u0430\u0448 \u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 COVID-19 \u0432 \u0432\u0430\u0448\u0435\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0435. \u0412\u044b, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0432\u043e\u0439\u0434\u0435\u0442\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 COVID-19 \u0432 \u043a\u043b\u0438\u043d\u0438\u043a\u0435, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435 \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c. (\u0412\u041e\u0417)", "cdcFaceRecommends": "\u041c\u0430\u0441\u043a\u0438 \u0434\u043b\u044f \u043b\u0438\u0446\u0430 \u043b\u0443\u0447\u0448\u0435 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442 \u0432\u0438\u0440\u0443\u0441, \u0447\u0435\u043c \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u044e\u0442 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044e. \u0412\u041e\u0417 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u043d\u043e\u0441\u0438\u0442\u044c \u043c\u0430\u0441\u043a\u0443, \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0432\u044b \u0431\u043e\u043b\u0435\u0435\u0442\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 COVID-19 \u0438\u043b\u0438 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0435 \u0437\u0430 \u043a\u0435\u043c-\u0442\u043e \u0441 COVID-19. \u0412 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435 \u043e\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u0441\u043a\u0438 \u043f\u043e \u043c\u0435\u0440\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438."}, "true_or_false": {"array": ["\u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f,\u0447\u0442\u043e \u0432\u0438\u0440\u0443\u0441 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443", "\u0414\u0435\u0442\u0438\u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f", "\u0425\u043e\u0434\u0438\u0442\u044c\u0432 \u043f\u0430\u0440\u043a\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442\u0441\u044f, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043f\u0430\u0440\u043a\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430 \u0443\u043b\u0438\u0446\u0435.", "\u0415\u0441\u043b\u0438\u0443 \u043c\u0435\u043d\u044f \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u043a\u0430\u043a\u0438\u0435-\u043b\u0438\u0431\u043e \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u041a\u041e\u0412\u0418\u0414-19, \u044f \u0434\u043e\u043b\u0436\u0435\u043d \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u0439\u0442\u0438 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438.", "\u041c\u043e\u043b\u043e\u0434\u044b\u0435\u043b\u044e\u0434\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 20 \u0434\u043e 60 \u043b\u0435\u0442 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c.", "\u0412\u0438\u0440\u0443\u0441- \u044d\u0442\u043e \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0439 \u043f\u0430\u043a\u0435\u0442 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0439\u0441\u044f \u0432 \u0431\u0435\u043b\u043a\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0435. \u0412\u0438\u0440\u0443\u0441\u044b \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0442 \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c, \u0432\u0442\u043e\u0440\u0433\u0430\u044e\u0442\u0441\u044f \u0432 \u043a\u043b\u0435\u0442\u043a\u0438-\u0445\u043e\u0437\u044f\u0435\u0432\u0430 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0438\u0445 \u0434\u0435\u043b\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043f\u0438\u0439 \u0432\u0438\u0440\u0443\u0441\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u0433\u0438\u0431\u0435\u043b\u0438 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a \u0438 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0434\u0440\u0443\u0433\u0438\u0445 \u043a\u043b\u0435\u0442\u043e\u043a, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043b\u044e\u0434\u0435\u0439 \u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438.", "\u041c\u043e\u043b\u043e\u0434\u044b\u0435\u043b\u044e\u0434\u0438 \u043c\u043e\u0433\u0443\u0442 \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u0443\u043b\u0438\u0446\u0443 \u0438 \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0435\u0442 \u0440\u0438\u0441\u043a\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f COVID-19", "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 COVID-19, \u043d\u043e \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432.", "COVID-19\u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0433\u0440\u0438\u043f\u043f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0437\u0430\u0442\u0440\u043e\u043d\u0435\u0442 \u0442\u0430\u043a\u043e\u0435 \u0436\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439.", "\u0413\u0440\u0438\u043f\u043f\u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u044e\u0434\u0435\u0439 \u0432 \u0433\u043e\u0434, \u043d\u043e \u043c\u044b \u043d\u0435 \u043d\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u043c \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043a\u0440\u0430\u0439\u043d\u0438\u0435 \u043c\u0435\u0440\u044b, \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0435 \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f COVID-19, \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e \u0440\u0430\u0437\u0434\u0443\u0442\u044b.", "\u0415\u0441\u043b\u0438\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0441\u0435\u0431\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u043c, \u044f \u043c\u043e\u0433\u0443 \u043d\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439, \u043d\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u044f\u0441\u044c \u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438.", "\u0415\u0441\u043b\u0438\u0432\u044b \u043f\u043e\u0439\u0434\u0435\u0442\u0435 \u0432 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0434\u0435\u0440\u0436\u0430\u0441\u044c \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 2 \u043c\u0435\u0442\u0440\u043e\u0432 \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439.", "\u041c\u044b\u0442\u044c\u0435\u0440\u0443\u043a \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u0432\u0438\u0440\u0443\u0441 \u0431\u043e\u043b\u0435\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e, \u0447\u0435\u043c \u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0440\u0443\u043a.", "CDC\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u043d\u043e\u0441\u0438\u0442\u044c \u0442\u043a\u0430\u043d\u0435\u0432\u043e\u0435 \u043b\u0438\u0446\u0435\u0432\u043e\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0440\u0438 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0438 \u0440\u0430\u0439\u043e\u043d\u043e\u0432 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043f\u043e\u0441\u0435\u0449\u0430\u0435\u043c\u043e\u0441\u0442\u044c\u044e, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442\u044b \u0438 \u0430\u043f\u0442\u0435\u043a\u0438. \u0421\u0430\u043c\u043e\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043c\u0430\u0441\u043a\u0438 \u043d\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044e\u0442 \u043f\u043e\u043b\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u043d\u043e \u043b\u0443\u0447\u0448\u0435, \u0447\u0435\u043c \u043d\u0438\u0447\u0435\u0433\u043e. \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0430\u0441\u043a\u0438 \u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u044b N95 \u0432\u0441\u0435 \u0436\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0434\u043b\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0438 \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435."], "virusPersontopersonIs": "\u0414\u0435\u0442\u0438 \u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0443 \u0440\u0438\u0441\u043a\u0443 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f", "socialDistancingAvoiding": "\u0425\u043e\u0434\u0438\u0442\u044c \u0432 \u043f\u0430\u0440\u043a\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442\u0441\u044f, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043f\u0430\u0440\u043a\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430 \u0443\u043b\u0438\u0446\u0435.", "parkGroupHanging": "\u0415\u0441\u043b\u0438 \u0443 \u043c\u0435\u043d\u044f \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u043a\u0430\u043a\u0438\u0435-\u043b\u0438\u0431\u043e \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u041a\u041e\u0412\u0418\u0414-19, \u044f \u0434\u043e\u043b\u0436\u0435\u043d \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u0439\u0442\u0438 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438.", "symptomsCovid19Experience": "\u041c\u043e\u043b\u043e\u0434\u044b\u0435 \u043b\u044e\u0434\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 20 \u0434\u043e 60 \u043b\u0435\u0442 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c.", "peopleYearsGet": "\u0412\u0438\u0440\u0443\u0441 - \u044d\u0442\u043e \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0439 \u043f\u0430\u043a\u0435\u0442 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0439\u0441\u044f \u0432 \u0431\u0435\u043b\u043a\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0435. \u0412\u0438\u0440\u0443\u0441\u044b \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0442 \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c, \u0432\u0442\u043e\u0440\u0433\u0430\u044e\u0442\u0441\u044f \u0432 \u043a\u043b\u0435\u0442\u043a\u0438-\u0445\u043e\u0437\u044f\u0435\u0432\u0430 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0438\u0445 \u0434\u0435\u043b\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043f\u0438\u0439 \u0432\u0438\u0440\u0443\u0441\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u0433\u0438\u0431\u0435\u043b\u0438 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a \u0438 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0434\u0440\u0443\u0433\u0438\u0445 \u043a\u043b\u0435\u0442\u043e\u043a, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043b\u044e\u0434\u0435\u0439 \u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438.", "peopleRiskGo": "\u041c\u043e\u043b\u043e\u0434\u044b\u0435 \u043b\u044e\u0434\u0438 \u043c\u043e\u0433\u0443\u0442 \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u0443\u043b\u0438\u0446\u0443 \u0438 \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0435\u0442 \u0440\u0438\u0441\u043a\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f COVID-19", "virusCovid19Is": "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 COVID-19, \u043d\u043e \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432.", "covid19NumberIs": "COVID-19 \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0433\u0440\u0438\u043f\u043f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u0437\u0430\u0442\u0440\u043e\u043d\u0435\u0442 \u0442\u0430\u043a\u043e\u0435 \u0436\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439.", "fluThousandsKills": "\u0413\u0440\u0438\u043f\u043f \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0442\u044b\u0441\u044f\u0447\u0438 \u043b\u044e\u0434\u0435\u0439 \u0432 \u0433\u043e\u0434, \u043d\u043e \u043c\u044b \u043d\u0435 \u043d\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u043c \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, \u043a\u0440\u0430\u0439\u043d\u0438\u0435 \u043c\u0435\u0440\u044b, \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0435 \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f COVID-19, \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e \u0440\u0430\u0437\u0434\u0443\u0442\u044b.", "friendsDiseaseFeel": "\u0415\u0441\u043b\u0438 \u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0441\u0435\u0431\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u043c, \u044f \u043c\u043e\u0433\u0443 \u043d\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439, \u043d\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u044f\u0441\u044c \u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438.", "groceryStoreGo": "\u0415\u0441\u043b\u0438 \u0432\u044b \u043f\u043e\u0439\u0434\u0435\u0442\u0435 \u0432 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0440\u0438\u0441\u043a \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0434\u0435\u0440\u0436\u0430\u0441\u044c \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 2 \u043c\u0435\u0442\u0440\u043e\u0432 \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439.", "handBreaksWashing": "\u041c\u044b\u0442\u044c\u0435 \u0440\u0443\u043a \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u0432\u0438\u0440\u0443\u0441 \u0431\u043e\u043b\u0435\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e, \u0447\u0435\u043c \u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0440\u0443\u043a.", "stockMasksSave": "CDC \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u043d\u043e\u0441\u0438\u0442\u044c \u0442\u043a\u0430\u043d\u0435\u0432\u043e\u0435 \u043b\u0438\u0446\u0435\u0432\u043e\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0440\u0438 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0438 \u0440\u0430\u0439\u043e\u043d\u043e\u0432 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043f\u043e\u0441\u0435\u0449\u0430\u0435\u043c\u043e\u0441\u0442\u044c\u044e, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442\u044b \u0438 \u0430\u043f\u0442\u0435\u043a\u0438. \u0421\u0430\u043c\u043e\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043c\u0430\u0441\u043a\u0438 \u043d\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044e\u0442 \u043f\u043e\u043b\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b, \u043d\u043e \u043b\u0443\u0447\u0448\u0435, \u0447\u0435\u043c \u043d\u0438\u0447\u0435\u0433\u043e. \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0430\u0441\u043a\u0438 \u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u044b N95 \u0432\u0441\u0435 \u0436\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0434\u043b\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0438 \u0432\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435."}}, "research": {"fact": {"array": ["\u0412\u0440\u0435\u043c\u044f,\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u0438\u0440\u0443\u0441 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0436\u0438\u0442\u044c \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438, \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044b. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0432\u0438\u0440\u0443\u0441 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0442\u0432\u0435\u0440\u0434\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445 \u0434\u043e \u0434\u0432\u0443\u0445 \u043d\u0435\u0434\u0435\u043b\u044c, \u043d\u043e \u0432\u044b\u0436\u0438\u0432\u0430\u0435\u0442 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u043f\u043e\u0440\u0438\u0441\u0442\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043e\u0434\u0435\u0436\u0434\u0430 \u0438 \u043a\u0430\u0440\u0442\u043e\u043d. (\u0412\u041e\u0417)", "\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442, \u0447\u0442\u043e COVID-19 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u0441 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u0430\u043f\u043b\u044f\u043c\u0438, \u0430 \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 \u0432\u043e\u0437\u0434\u0443\u0445.", "\u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439\u043f\u0435\u0440\u0438\u043e\u0434 \u0434\u043b\u044f COVID-19 \u0432\u0430\u0440\u044c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043e\u0442 1 \u0434\u043e 14 \u0434\u043d\u0435\u0439, \u0430 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043d\u044f\u0442\u044c \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0448\u0438\u0439 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0437\u0430\u0440\u0430\u0437\u0435\u043d \u043d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f. \u0412\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u0430\u043a \u0432\u0430\u0436\u043d\u043e \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438.", "\u0412\u044b\u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0437\u0430\u043f\u0430\u0441 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u043e\u043a, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0445 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0438 \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 COVID-19 \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u0434\u043e\u043c\u0430.", "\u0412\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0435\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430 \u0438\u043b\u0438 \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u0434\u043b\u044f COVID-19. \u041f\u043e \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u043c \u043e\u0446\u0435\u043d\u043a\u0430\u043c, \u0434\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f 12-18 \u043c\u0435\u0441\u044f\u0446\u0435\u0432. \u0412\u0430\u043a\u0446\u0438\u043d\u044b \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442 \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438, \u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f.", "\u0423\u0447\u0435\u043d\u044b\u0435\u0438\u0437 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u0438 \u0438\u0449\u0443\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430, \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0435 FDA, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f COVID-19. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0438 \u0434\u0435\u0448\u0435\u0432\u043b\u0435, \u0447\u0435\u043c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0441 \u043d\u0443\u043b\u044f. \u041e\u043d\u0438 \u0438\u0449\u0443\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u0430\u0446\u0435\u043b\u0435\u043d\u044b \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0443\u0441\u0443 \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u0442\u044c \u0432 \u043a\u043b\u0435\u0442\u043a\u0443-\u0445\u043e\u0437\u044f\u0438\u043d\u0430. \u041e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0432\u0438\u0440\u0443\u0441 \u043d\u0430 \u0435\u0433\u043e \u043f\u0443\u0442\u0438.", "\u041d\u043e\u0432\u044b\u0439\u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441 2019-nCoV, \u0432\u044b\u0437\u0432\u0430\u0432\u0448\u0438\u0439 \u044d\u0442\u0443 \u043f\u0430\u043d\u0434\u0435\u043c\u0438\u044e, \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u044b, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435 \u0443 \u043b\u0435\u0442\u0443\u0447\u0438\u0445 \u043c\u044b\u0448\u0435\u0439", ""], "amountTimeSurvive": "\u0412\u0440\u0435\u043c\u044f, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u0438\u0440\u0443\u0441 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0436\u0438\u0442\u044c \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438, \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044b. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0432\u0438\u0440\u0443\u0441 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0442\u0432\u0435\u0440\u0434\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445 \u0434\u043e \u0434\u0432\u0443\u0445 \u043d\u0435\u0434\u0435\u043b\u044c, \u043d\u043e \u0432\u044b\u0436\u0438\u0432\u0430\u0435\u0442 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u043d\u044c\u0448\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u043f\u043e\u0440\u0438\u0441\u0442\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043e\u0434\u0435\u0436\u0434\u0430 \u0438 \u043a\u0430\u0440\u0442\u043e\u043d. (\u0412\u041e\u0417)", "studiesDateIs": "\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c, \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442, \u0447\u0442\u043e COVID-19 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u0441 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u0430\u043f\u043b\u044f\u043c\u0438, \u0430 \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 \u0432\u043e\u0437\u0434\u0443\u0445.", "incubationPeriodMeaning": "\u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0434\u043b\u044f COVID-19 \u0432\u0430\u0440\u044c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043e\u0442 1 \u0434\u043e 14 \u0434\u043d\u0435\u0439, \u0430 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043d\u044f\u0442\u044c \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0448\u0438\u0439 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0437\u0430\u0440\u0430\u0437\u0435\u043d \u043d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f. \u0412\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u0430\u043a \u0432\u0430\u0436\u043d\u043e \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438.", "treatmentsVaccinesAre": "\u0412\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0437\u0430\u043f\u0430\u0441 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u043e\u043a, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0445 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0438 \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 COVID-19 \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u0434\u043e\u043c\u0430.", "scientistsColumbiaAre": "\u0412 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0435\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430 \u0438\u043b\u0438 \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u0434\u043b\u044f COVID-19. \u041f\u043e \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u043c \u043e\u0446\u0435\u043d\u043a\u0430\u043c, \u0434\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u0434\u043b\u044f \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f 12-18 \u043c\u0435\u0441\u044f\u0446\u0435\u0432. \u0412\u0430\u043a\u0446\u0438\u043d\u044b \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442 \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438, \u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f.", "sarscov2VirusCauses": "\u0423\u0447\u0435\u043d\u044b\u0435 \u0438\u0437 \u041a\u043e\u043b\u0443\u043c\u0431\u0438\u0438 \u0438\u0449\u0443\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430, \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0435 FDA, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f COVID-19. \u042d\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0438 \u0434\u0435\u0448\u0435\u0432\u043b\u0435, \u0447\u0435\u043c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0441 \u043d\u0443\u043b\u044f. \u041e\u043d\u0438 \u0438\u0449\u0443\u0442 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u0430\u0446\u0435\u043b\u0435\u043d\u044b \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0438\u0440\u0443\u0441\u0443 \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u0442\u044c \u0432 \u043a\u043b\u0435\u0442\u043a\u0443-\u0445\u043e\u0437\u044f\u0438\u043d\u0430. \u041e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u0432\u0438\u0440\u0443\u0441 \u043d\u0430 \u0435\u0433\u043e \u043f\u0443\u0442\u0438.", "conspiracyTheoristsHave": "\u041d\u043e\u0432\u044b\u0439 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441 2019-nCoV, \u0432\u044b\u0437\u0432\u0430\u0432\u0448\u0438\u0439 \u044d\u0442\u0443 \u043f\u0430\u043d\u0434\u0435\u043c\u0438\u044e, \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u044b, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435 \u0443 \u043b\u0435\u0442\u0443\u0447\u0438\u0445 \u043c\u044b\u0448\u0435\u0439", "typesSarscov2Have": ""}}, "science": {"fact": {"array": ["\u0412\u041a\u041e\u0412\u0418\u0414-19 \u00ab\u041a\u041e\u00bb \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u043a\u043e\u0440\u043e\u043d\u0430\u00bb, \u00ab\u0412\u0418\u00bb - \u00ab\u0432\u0438\u0440\u0443\u0441\u00bb, \u0430 \u00ab\u0414\u00bb - \u0431\u043e\u043b\u0435\u0437\u043d\u044c. \u0420\u0430\u043d\u0435\u0435 \u044d\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u00ab\u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441 2019 \u0433\u043e\u0434\u0430\u00bb \u0438\u043b\u0438 \u00ab2019-\u043d\u041a\u043e\u0412\u00bb.", "\u042d\u0442\u043e\u0442\u0432\u0438\u0440\u0443\u0441 \u0431\u044b\u043b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0423\u0445\u0430\u043d\u044c, \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f \u0425\u0443\u0431\u044d\u0439, \u041a\u0438\u0442\u0430\u0439. \u041f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441 \u0440\u044b\u043d\u043a\u043e\u043c \u0436\u0438\u0432\u044b\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445, \u043d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u0438\u0440\u0443\u0441 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443.", "\u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432\u0438\u0440\u0443\u0441\u0430, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u041a\u041e\u0412\u0418\u0414-19 (COVID-19), - SARS-CoV-2.", "\u0414\u0438\u0430\u043c\u0435\u0442\u0440\u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u043a\u043e\u043b\u043e 120 \u043d\u043c.  \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u043e\u043a\u043e\u043b\u043e 2500 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446 \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u043a\u0440\u0443\u043f\u0438\u043d\u043a\u0435 \u0441\u043e\u043b\u0438!", "\u0412\u0438\u0440\u0443\u0441\u044b\u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0436\u0438\u0432\u044b\u043c\u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430\u043c\u0438.  \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439, \u0432\u0438\u0440\u0443\u0441\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0430\u0442\u044c\u0441\u044f \u0438 \u0436\u0438\u0442\u044c \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e.  \u041e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c \u0445\u043e\u0437\u044f\u0438\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0436\u0438\u0442\u044c \u0438 \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0438\u0442\u044c\u0441\u044f.", "\u0427\u0442\u043e\u0431\u044b\u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f \u0441 \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u0438\u043c\u043c\u0443\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0442\u044c \u0435\u0433\u043e \u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c.  \u0412\u0438\u0440\u0443\u0441\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u00ab\u0443\u0431\u0438\u0442\u044c\u00bb \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0435 \u0436\u0438\u0432\u044b.", "\u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432\u0438\u0440\u0443\u0441\u0430 - SARS-CoV-2 (\u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u043e\u0441\u0442\u0440\u044b\u0439 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u041a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430 2).  \u041f\u0435\u0440\u0432\u044b\u0439 SARS-CoV \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0432 2002 \u0433\u043e\u0434\u0443 \u0438 \u0431\u044b\u043b \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430 \u0432\u0441\u043f\u044b\u0448\u043a\u0443 SARS.  \u0425\u043e\u0442\u044f \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u044c \u043e\u0442 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u0431\u044b\u043b\u0430 \u0432\u044b\u0448\u0435, \u0447\u0435\u043c \u0443 \u041a\u041e\u0412\u0418\u0414-19, \u043e\u043d\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0430 \u0438 \u0443\u0431\u0438\u043b\u0430 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043c\u0435\u043d\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439.  \u0421 2003 \u0433\u043e\u0434\u0430 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u041e\u0420\u0412\u0418 \u043d\u0435 \u0431\u044b\u043b\u043e.", "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442\u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u0431\u0430\u043a\u0438 SARS-CoV-2, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u0430\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0442\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u044c. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0432\u044b \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u044b \u043c\u044b\u0442\u044c \u0440\u0443\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u043c\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u0441 \u0441\u043e\u0431\u0430\u043a\u043e\u0439. \u0421\u043e\u0431\u0430\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u0438\u0440\u0443\u0441 \u043d\u0430 \u0441\u0435\u0431\u0435. (\u0412\u041e\u0417)", "\u041f\u0440\u0438\u0435\u043c\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f COVID-19, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0432\u0438\u0440\u0443\u0441\u043e\u043c. \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0443\u0431\u0438\u0432\u0430\u044e\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438 \u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044e \u0432\u0440\u0430\u0447\u0430. \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u0438\u043d\u0435\u0441\u0442\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0440\u0435\u0434\u0430, \u0447\u0435\u043c \u043f\u043e\u043b\u044c\u0437\u044b, \u0435\u0441\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e. (\u0412\u041e\u0417)", "", "", "", "", ""], "covid19\u2018Stands": "\u0412 \u041a\u041e\u0412\u0418\u0414-19 \u00ab\u041a\u041e\u00bb \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u043a\u043e\u0440\u043e\u043d\u0430\u00bb, \u00ab\u0412\u0418\u00bb - \u00ab\u0432\u0438\u0440\u0443\u0441\u00bb, \u0430 \u00ab\u0414\u00bb - \u0431\u043e\u043b\u0435\u0437\u043d\u044c. \u0420\u0430\u043d\u0435\u0435 \u044d\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u00ab\u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441 2019 \u0433\u043e\u0434\u0430\u00bb \u0438\u043b\u0438 \u00ab2019-\u043d\u041a\u043e\u0412\u00bb.", "virusWuhanWas": "\u042d\u0442\u043e\u0442 \u0432\u0438\u0440\u0443\u0441 \u0431\u044b\u043b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u0423\u0445\u0430\u043d\u044c, \u043f\u0440\u043e\u0432\u0438\u043d\u0446\u0438\u044f \u0425\u0443\u0431\u044d\u0439, \u041a\u0438\u0442\u0430\u0439. \u041f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441 \u0440\u044b\u043d\u043a\u043e\u043c \u0436\u0438\u0432\u044b\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445, \u043d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u0438\u0440\u0443\u0441 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443.", "nameVirusCauses": "\u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432\u0438\u0440\u0443\u0441\u0430, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u041a\u041e\u0412\u0418\u0414-19 (COVID-19), - SARS-CoV-2.", "coronavirusDiameterIs": "\u0414\u0438\u0430\u043c\u0435\u0442\u0440 \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u043a\u043e\u043b\u043e 120 \u043d\u043c.  \u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u043e\u043a\u043e\u043b\u043e 2500 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446 \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u043a\u0440\u0443\u043f\u0438\u043d\u043a\u0435 \u0441\u043e\u043b\u0438!", "virusesOrganismsAre": "\u0412\u0438\u0440\u0443\u0441\u044b \u043d\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0436\u0438\u0432\u044b\u043c\u0438 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430\u043c\u0438.  \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439, \u0432\u0438\u0440\u0443\u0441\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0430\u0442\u044c\u0441\u044f \u0438 \u0436\u0438\u0442\u044c \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e.  \u041e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u044c \u0445\u043e\u0437\u044f\u0438\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0436\u0438\u0442\u044c \u0438 \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0438\u0442\u044c\u0441\u044f.", "orderVirusFight": "\u0427\u0442\u043e\u0431\u044b \u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f \u0441 \u0432\u0438\u0440\u0443\u0441\u043e\u043c, \u0438\u043c\u043c\u0443\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0442\u044c \u0435\u0433\u043e \u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c.  \u0412\u0438\u0440\u0443\u0441\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u00ab\u0443\u0431\u0438\u0442\u044c\u00bb \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0435 \u0436\u0438\u0432\u044b.", "nameVirusIs": "\u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432\u0438\u0440\u0443\u0441\u0430 - SARS-CoV-2 (\u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u043e\u0441\u0442\u0440\u044b\u0439 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u041a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u0430 2).  \u041f\u0435\u0440\u0432\u044b\u0439 SARS-CoV \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0432 2002 \u0433\u043e\u0434\u0443 \u0438 \u0431\u044b\u043b \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0437\u0430 \u0432\u0441\u043f\u044b\u0448\u043a\u0443 SARS.  \u0425\u043e\u0442\u044f \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u044c \u043e\u0442 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u0431\u044b\u043b\u0430 \u0432\u044b\u0448\u0435, \u0447\u0435\u043c \u0443 \u041a\u041e\u0412\u0418\u0414-19, \u043e\u043d\u0430 \u0437\u0430\u0440\u0430\u0437\u0438\u043b\u0430 \u0438 \u0443\u0431\u0438\u043b\u0430 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043c\u0435\u043d\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439.  \u0421 2003 \u0433\u043e\u0434\u0430 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u041e\u0420\u0412\u0418 \u043d\u0435 \u0431\u044b\u043b\u043e.", "caseDogIs": "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u0431\u0430\u043a\u0438 SARS-CoV-2, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u0430\u043b\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0442\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u044c. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0432\u044b \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u044b \u043c\u044b\u0442\u044c \u0440\u0443\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u043c\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438 \u0441 \u0441\u043e\u0431\u0430\u043a\u043e\u0439. \u0421\u043e\u0431\u0430\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u04