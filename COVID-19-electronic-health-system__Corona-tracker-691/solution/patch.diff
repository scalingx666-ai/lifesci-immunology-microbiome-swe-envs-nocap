gsOrAtWork": " \u0418\u043d\u043e\u0433\u0434\u0430 - \u044f \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043b \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435 \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u0430\u0445, \u0441\u043e\u0431\u0440\u0430\u043d\u0438\u044f\u0445 \u0438 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435", "noneOfTheTime": " \u041d\u0435\u0442, \u044f \u043d\u0435 \u043d\u0430\u0445\u043e\u0436\u0443\u0441\u044c \u0432 \u0441\u0430\u043c\u043e\u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438"}, "sleeping": {"array": [""], "troubleFallingOrStayingAsleepOrSleepingTooMuch": ""}, "thermometer": {"array": ["\u0415\u0441\u0442\u044c\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0433\u0440\u0430\u0434\u0443\u0441\u043d\u0438\u043a?"], "doYouHaveAccessToAThermometer": "\u0415\u0441\u0442\u044c \u043b\u0438 \u0443 \u0432\u0430\u0441 \u0433\u0440\u0430\u0434\u0443\u0441\u043d\u0438\u043a?"}}, "physical": {"questionSymptom": {"array": ["\u041a\u0430\u043a\u0438\u0435\u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430?"], "whichSymptomsAreYouFeelingOrExperiencing": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430?"}, "symptomOther": {"array": ["\u041a\u0430\u043a\u0438\u0435\u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0414\u0440\u0443\u0433\u0438\u0435?"], "anythingOtherSymptomsOrCommentsYouWantToAdd": "\u041a\u0430\u043a\u0438\u0435 \u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0414\u0440\u0443\u0433\u0438\u0435?"}, "symptomValue": {"array": ["\u041a\u0430\u043a\u0438\u0435\u0443 \u0432\u0430\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b? \u0412\u0430\u0441 \u0437\u043d\u043