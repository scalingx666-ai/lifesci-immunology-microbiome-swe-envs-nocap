+
+    # aldex2 and dependencies 
+    Rscript -e 'BiocManager::install("SummarizedExperiment")'
+    Rscript -e 'BiocManager::install("GenomicRanges")'
+    Rscript -e 'BiocManager::install("BiocParallel")'
+    Rscript -e 'BiocManager::install("ALDEx2")'
+
