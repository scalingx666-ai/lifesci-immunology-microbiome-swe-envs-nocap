-def random_tweak(weights, scale=0.2):
-    """
-    Returns a new dict, each weight randomly offset by up to ±scale.
-    Clamps at 0 (no negative).
-    """
-    new_w = {}
-    for k, v in weights.items():
-        delta = random.uniform(-scale, scale)
-        candidate = v + delta
-        if candidate < 0 :
-            candidate = 0.0
-
-        new_w[k] = candidate
-    return new_w
