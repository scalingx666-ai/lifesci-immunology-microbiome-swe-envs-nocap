+# Does not overwrite an existing file (or its .gz)
+RenameGeneCallerGFFs() {
+    local root=$1 f target n=0
+    while IFS= read -r -d '' f; do
+        case "$f" in
+            *.braker.gff3)  target="${f%.braker.gff3}_braker.gff" ;;
