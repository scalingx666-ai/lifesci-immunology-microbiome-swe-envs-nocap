+static inline int putu128(__uint128_t big, FILE *fp) {
+    char buf[40]{0}, *p(buf);
+    while(big > 0) *p++ = (uint64_t)big % 10 + '0', big /= 10;
+    p[1] = '\0';
+    const unsigned diff(p - buf);
+    for(unsigned i(0), e(diff >> 1); i != e; ++i) {
+        const int8_t t(buf[i]);
+        buf[i] = buf[diff - i - 1];
+        buf[diff - i - 1] = t;
+    }
+    return fputs(buf, fp) + fputc('\n', fp);
+}
