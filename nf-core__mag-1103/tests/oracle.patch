diff --git a/main.nf b/main.nf
index 14c9ef15f..52ae3383f 100644
--- a/main.nf
+++ b/main.nf
@@ -20,6 +20,241 @@ include { PIPELINE_INITIALISATION } from './subworkflows/local/utils_nfcore_mag_
 include { PIPELINE_COMPLETION     } from './subworkflows/local/utils_nfcore_mag_pipeline'
