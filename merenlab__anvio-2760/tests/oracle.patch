+    anvi-gen-structure-database -c test-output/one_contig_five_genes.db \
+                                --engine colabfold \
+                                --colabfold-conda-env "$COLABFOLD_CONDA_ENV" \
+                                --colabfold-db "$COLABFOLD_DB" \
+                                --skip-DSSP \
+                                --gene-caller-ids 2 \
+                                --num-models 1 \
+                                --dump-dir test-output/COLABFOLD_CHECKPOINT \
+                                --only-msa \
+                                $thread_controller \
+                                --debug
+
