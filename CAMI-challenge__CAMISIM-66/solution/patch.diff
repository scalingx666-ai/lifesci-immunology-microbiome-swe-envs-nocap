+        @return: lineage for each genome id using genome id as key
+        @rtype: dict[str|unicode, list[None|str|unicode]]
+        """
+        strains_by_taxid = {}
+        genome_id_to_lineage = {}
+        for genome_id in list_of_genome_id:
+            tax_id = genome_id_to_taxid[genome_id]
