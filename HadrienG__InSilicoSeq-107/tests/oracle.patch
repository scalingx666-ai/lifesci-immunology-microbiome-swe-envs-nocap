+def compress(filename):
+    """gzip a file
+
+    Args:
+        filename (string): name of file to be compressed
+    """
+    logger = logging.getLogger(__name__)
+    logger.info('Compressing %s' % filename)
+    outfile = filename + '.gz'
+    with open(filename, 'rb') as i, gzip.open(outfile, 'wb') as o:
+        copyfileobj(i, o)
+    return outfile
