diff --git a/test/internal.jl b/test/internal.jl
index 2bc9b9fb..1b4d632a 100644
--- a/test/internal.jl
+++ b/test/internal.jl
@@ -545,3 +545,61 @@ end
     @test all(cum[k] ≈ pair[k] for k in keys(cum))
