+
+[project]
+name = "woltka"
+dynamic = ["version"]
+dependencies = [
+  "numba",
+  "biom-format",
+]
+requires-python = ">=3.6"
+authors = [
+  {name = "Qiyun Zhu", email = "qiyunzhu@gmail.com"}
+]
+maintainers = [
+  {name = "Qiyun Zhu", email = "qiyunzhu@gmail.com"}
+]
+description = "versatile meta-omic data classifier"
+readme = "README.md"
+license = {file = "LICENSE"}
+keywords = ["bioinformatics", "metagenomics", "microbiome"]
+classifiers = [
