--- a/.github/workflows/Dockerfile.GPU-buster-cross-sbsa
+++ b/.github/workflows/Dockerfile.GPU-buster-cross-sbsa
@@ -1,9 +1,9 @@
-FROM ghcr.io/steineggerlab/build-containers:main-sbsa-cuda13
+FROM ghcr.io/steineggerlab/build-containers:main-sbsa-cuda13 AS builder
 WORKDIR /work
 ADD . .
 
 RUN mkdir -p /work/build && cd /work/build; \
-    /usr/local/bin/cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DHAVE_TESTS=1 -DENABLE_WERROR=1 -DHAVE_ARM8=1 \
