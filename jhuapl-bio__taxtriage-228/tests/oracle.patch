+      }
+
+      function _embedRender() {
+        _embedRenderScatter();
+        _embedRenderFamTable();
+        _embedRenderOrfTable();
+      }
+
+      // Build a quick {query_id -> novelty flag} map so scatter points can colour by novelty.
+      function _embedNoveltyMap(blocks) {
+        const m = {};
+        (blocks.clusters || []).forEach((r) => {
+          if (r.query_id != null) m[String(r.query_id)] = String(r.novel_flag || "");
+        });
+        return m;
+      }
+
+      // Nearest-gene map for the active sample: query_id -> {ref, cosine, topk:[{id,gene,product,function,cls}]}.
+      // Built by make_report.py from the BV-BRC --annotate TSV (only present when that file was passed).
+      function _embedNearest(blocks) {
+        return (blocks && blocks.nearest) || {};
+      }
+
+      // One-line summary of the single closest reference gene (for hover tooltips).
+      function _embedNearestLine(entry) {
+        if (!entry || !entry.topk || !entry.topk.length) return "";
+        const t = entry.topk[0];
+        const name = t.gene || t.product || t.id || "";
+        const fn = t.function || t.product || "";
+        const cos = entry.cosine != null ? ` (cos ${_embedFmt(entry.cosine)})` : "";
+        let s = `<br><b>closest:</b> ${_esc(name)}${cos}`;
+        if (fn && fn !== name) s += `<br>${_esc(fn)}`;
+        if (t.cls) s += `<br><span style="opacity:.8">${_esc(t.cls)}</span>`;
+        return s;
+      }
+
+      // Full top-k table of nearest reference genes (for click-to-expand / pinned detail).
+      function _embedNearestTable(qid, entry) {
+        if (!entry || !entry.topk || !entry.topk.length) {
+          return `<div style="color:#888;font-size:11px">No nearest-reference match for ${_esc(
+            String(qid),
+          )} (below the embedding cosine cutoff, or no --annotate reference supplied).</div>`;
+        }
+        const canJump = _embedProteinsAvailable();
+        const cols = ["#", "ref id", "gene", "product / function", "class"];
+        if (canJump) cols.push("");
+        const head =
+          `<tr>` +
+          cols
+            .map((h) => `<th style="text-align:left;padding:2px 7px;border-bottom:1px solid #dee2e6">${h}</th>`)
+            .join("") +
+          `</tr>`;
+        const body = entry.topk
+          .map((t, i) => {
+            const pf = t.function || t.product || "";
+            const note =
+              i === 0 && entry.cosine != null ? ` <span style="opacity:.7">cos ${_embedFmt(entry.cosine)}</span>` : "";
+            // search the VF/AMR table by gene name when present, else the ref id.
+            const q = (t.gene || t.id || "").replace(/'/g, "\\'");
+            const jump = canJump
+              ? `<td style="padding:2px 7px"><button onclick="_embedJumpToProteins('${_esc(q)}')" ` +
+                `style="font-size:10px;padding:1px 6px;border:1px solid #adb5bd;border-radius:3px;` +
+                `background:#f1f3f5;cursor:pointer">VF/AMR&nbsp;&rsaquo;</button></td>`
+              : "";
+            return (
+              `<tr style="${i === 0 ? "background:#fff4e6" : ""}">` +
+              `<td style="padding:2px 7px">${i + 1}${note}</td>` +
+              `<td style="padding:2px 7px;font-family:monospace">${_esc(t.id || "")}</td>` +
+              `<td style="padding:2px 7px">${_esc(t.gene || "")}</td>` +
+              `<td style="padding:2px 7px">${_esc(pf)}</td>` +
+              `<td style="padding:2px 7px">${_esc(t.cls || "")}</td>` +
+              jump +
+              `</tr>`
+            );
+          })
+          .join("");
+        const jumpAll = canJump
+          ? `<button onclick="_embedJumpToProteins('${_esc(
+              (entry.topk[0].gene || entry.topk[0].id || "").replace(/'/g, "\\'"),
+            )}')" ` +
+            `style="margin-left:8px;font-size:10px;padding:1px 7px;border:1px solid #1c7ed6;border-radius:3px;` +
+            `background:#e7f5ff;color:#1565c0;cursor:pointer">open nearest in VF/AMR tab &rsaquo;</button>`
+          : "";
+        return (
+          `<div style="font-size:11px;font-weight:600;margin-bottom:3px">Closest reference genes for ${_esc(
+            String(qid),
+          )}${jumpAll}</div>` +
+          `<table style="border-collapse:collapse;font-size:11px;width:100%">${head}${body}</table>`
+        );
+      }
+
+      // Pinned, scrollable detail panel reused by both the scatter (click a point) and
+      // the ORF table (click a row). Created lazily; closes on its own ✕ button.
+      function _embedShowDetail(qid, entry, clientX, clientY) {
+        let panel = document.getElementById("embed-detail");
+        if (!panel) {
+          panel = document.createElement("div");
+          panel.id = "embed-detail";
+          panel.style.cssText =
+            "position:fixed;z-index:10000;background:#fff;color:#212529;border:1px solid #adb5bd;" +
+            "box-shadow:0 4px 18px rgba(0,0,0,.18);border-radius:6px;padding:10px 34px 12px 12px;" +
+            "max-width:540px;max-height:60vh;overflow:auto;font-size:11px";
+          document.body.appendChild(panel);
+        }
+        // Close button pinned to the far top-right corner with its own backdrop and a high
+        // z-index so the chart/table export icons can't sit on top of it.
+        panel.innerHTML =
+          `<button onclick="document.getElementById('embed-detail').style.display='none'" ` +
+          `title="Close" ` +
+          `style="position:absolute;top:5px;right:5px;z-index:3;width:20px;height:20px;line-height:18px;` +
+          `text-align:center;border:1px solid #dee2e6;border-radius:4px;background:#fff;` +
+          `font-size:14px;cursor:pointer;color:#868e96">&times;</button>` +
+          _embedNearestTable(qid, entry);
+        panel.style.display = "block";
+        const vw = window.innerWidth,
+          vh = window.innerHeight;
+        const x = clientX != null ? clientX : vw / 2;
+        const y = clientY != null ? clientY : vh / 2;
+        panel.style.left = Math.min(x + 12, vw - (panel.offsetWidth || 520) - 12) + "px";
+        panel.style.top = Math.min(y + 12, vh - (panel.offsetHeight || 200) - 12) + "px";
+      }
+
+      // ── cross-highlight helpers (table row -> scatter) ──────────────────────
+      function _embedClearHighlight() {
+        _embedState.highlightCluster = null;
+        _embedState.highlightOrf = null;
+        _embedRender();
+      }
+      function _embedToggleClusterHighlight(cid) {
+        const same = String(_embedState.highlightCluster) === String(cid) && _embedState.highlightOrf == null;
+        _embedState.highlightCluster = same ? null : String(cid);
+        _embedState.highlightOrf = null;
+        _embedRender();
+      }
+      function _embedHighlightOrf(qid, cid) {
+        const same = String(_embedState.highlightOrf) === String(qid);
+        _embedState.highlightOrf = same ? null : String(qid);
