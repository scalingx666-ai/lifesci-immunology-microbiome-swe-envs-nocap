+              }
+              fMin.disabled = false;
+              fMin.min = lo;
+              fMin.max = hi;
+              fMin.step = step;
+              fMin.value = lo;
+              _embedState.filterMin = +lo;
+              fVal.textContent = String(lo);
+            }
