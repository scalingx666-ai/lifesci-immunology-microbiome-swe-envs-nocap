+      function _embedMetricMap(blocks) {
+        const m = {};
+        (blocks.clusters || []).forEach((r) => {
+          if (r.query_id == null) return;
+          const k = String(r.query_id);
+          m[k] = m[k] || {};
+          if (r.outlier_score != null) m[k].outlier_score = +r.outlier_score;
+          if (r.cluster_size != null) m[k].cluster_size = +r.cluster_size;
+        });
+        (blocks.novelty || []).forEach((r) => {
+          if (r.query_id == null) return;
+          const k = String(r.query_id);
+          m[k] = m[k] || {};
+          if (r.novelty_score != null) m[k].novelty_score = +r.novelty_score;
+        });
+        return m;
+      }
+
+      const _EMBED_NOVELTY_COLORS = {
+        novel_family: "#e8590c",
+        novel_singleton: "#f59f00",
+        known: "#adb5bd",
+        "": "#ced4da",
+      };
+
+      function _embedSamples() {
+        return (EMBED && EMBED.samples) || {};
+      }
+
+      function _embedColorFor(p, colorBy, clusterScale) {
+        if (colorBy === "set") return String(p.set) === "query" ? "#1c7ed6" : "#ced4da";
+        if (colorBy === "novelty") {
+          return _EMBED_NOVELTY_COLORS[String(p._novelty || "")] ?? "#ced4da";
+        }
+        // cluster
+        const cid = String(p.cluster_id);
+        if (cid === "-1" || cid === "undefined" || cid === "null") return "#ced4da";
+        return clusterScale(cid);
+      }
+
+      function drawEmbed() {
+        const samples = _embedSamples();
