+            tip.innerHTML = lab;
+          })
+          .on("mouseleave", () => {
+            tip.style.display = "none";
+          })
+          .style("cursor", (p) => (String(p.set) === "query" && nearest[String(p.id)] ? "pointer" : "default"))
+          .on("click", (ev, p) => {
+            if (String(p.set) !== "query") return;
+            ev.stopPropagation();
+            _embedShowDetail(String(p.id), nearest[String(p.id)], ev.clientX, ev.clientY);
+          });
+
+        // ── zoom + pan (wheel / drag); double-click or button resets ──────────
+        const zoom = d3
+          .zoom()
+          .scaleExtent([0.6, 25])
+          .on("zoom", (ev) => {
+            plot.attr("transform", ev.transform);
+            _embedState._zoomT = ev.transform; // persist across re-renders (highlight/filter)
+          });
+        svg.call(zoom).on("dblclick.zoom", null);
+        svg.on("dblclick", () => {
+          _embedState._zoomT = null;
