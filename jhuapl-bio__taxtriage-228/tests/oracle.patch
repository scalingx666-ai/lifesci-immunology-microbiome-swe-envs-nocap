+        _embedRenderScatter();
+        _embedRenderFamTable();
+        _embedRenderOrfTable();
+      }
+
+      // ── jump to the VF/AMR (proteins) tab, pre-filtered by a gene/ref query ──
+      function _embedProteinsAvailable() {
+        const btn = document.querySelector('.tab-btn[data-tab="proteins"]');
+        return !!(btn && !btn.classList.contains("hidden"));
+      }
+      function _embedJumpToProteins(query) {
+        const btn = document.querySelector('.tab-btn[data-tab="proteins"]');
+        if (!btn || btn.classList.contains("hidden")) return;
+        btn.click();
+        setTimeout(() => {
+          const colSel = document.getElementById("prot-search-col");
+          const search = document.getElementById("prot-search");
+          if (colSel) colSel.value = ""; // search all columns (matches gene_name/product/source_id)
+          if (search) {
+            search.value = query;
+            search.dispatchEvent(new Event("input", { bubbles: true }));
+          }
+        }, 60);
+      }
+
+      function _embedRenderScatter() {
+        const wrap = document.getElementById("embed-scatter-svg");
+        const noUmap = document.getElementById("embed-no-umap");
+        const legend = document.getElementById("embed-legend");
+        const countEl = document.getElementById("embed-count");
+        wrap.innerHTML = "";
+        legend.innerHTML = "";
+        const blocks = _embedSamples()[_embedState.sample] || {};
+        let pts = (blocks.umap || []).slice();
+        if (!pts.length) {
+          noUmap.style.display = "";
+          countEl.textContent = "";
+          _embedRenderScatterFallbackLegend();
+          return;
+        }
+        noUmap.style.display = "none";
+
+        const novMap = _embedNoveltyMap(blocks);
+        const nearest = _embedNearest(blocks);
+        const metricMap = _embedMetricMap(blocks);
+        pts.forEach((p) => {
+          p._x = +p.x;
+          p._y = +p.y;
+          p._novelty = String(p.set) === "query" ? novMap[String(p.id)] || "" : "";
+        });
+        pts = pts.filter((p) => isFinite(p._x) && isFinite(p._y));
+        if (_embedState.hideRef) pts = pts.filter((p) => String(p.set) === "query");
+        if (_embedState.hideSingletons) pts = pts.filter((p) => String(p.cluster_id) !== "-1");
