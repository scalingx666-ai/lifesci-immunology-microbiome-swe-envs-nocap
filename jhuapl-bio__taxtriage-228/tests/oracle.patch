+            const v = (metricMap[String(p.id)] || {})[mk];
+            return v != null && v >= thr;
+          });
+        }
+
+        const hlActive = _embedState.highlightCluster != null || _embedState.highlightOrf != null;
+        document.getElementById("embed-clear-hl").style.display = hlActive ? "" : "none";
+        const _isHl = (p) => {
+          if (!hlActive) return true; // nothing highlighted -> everything full strength
+          if (_embedState.highlightOrf != null)
