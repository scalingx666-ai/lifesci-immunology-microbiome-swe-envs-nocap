+
+        // ── one-time control wiring ──────────────────────────────────────────
+        const sel = document.getElementById("embed-sample-sel");
+        if (!_embedState.wired) {
+          sel.innerHTML = names.map((n) => `<option value="${_esc(n)}">${_esc(n)}</option>`).join("");
+          _embedState.sample = names[0];
+          sel.value = _embedState.sample;
+          sel.addEventListener("change", () => {
+            _embedState.sample = sel.value;
+            _embedState._zoomT = null; // reset view when switching samples
+            _embedState.highlightCluster = null;
+            _embedState.highlightOrf = null;
+            _embedRender();
+          });
+          const colorSel = document.getElementById("embed-color-sel");
+          colorSel.addEventListener("change", () => {
+            _embedState.colorBy = colorSel.value;
+            _embedRender();
+          });
+          const hideRef = document.getElementById("embed-hide-ref");
+          hideRef.addEventListener("change", () => {
+            _embedState.hideRef = hideRef.checked;
+            _embedRender();
+          });
+          const orfSearch = document.getElementById("embed-orf-search");
+          orfSearch.addEventListener("input", () => {
+            _embedState.orfSearch = orfSearch.value.trim().toLowerCase();
+            _embedRenderOrfTable();
+          });
+          const novelOnly = document.getElementById("embed-orf-novel-only");
+          novelOnly.addEventListener("change", () => {
+            _embedState.novelOnly = novelOnly.checked;
+            _embedRenderOrfTable();
+          });
+          const hideSingles = document.getElementById("embed-hide-singletons");
+          hideSingles.addEventListener("change", () => {
+            _embedState.hideSingletons = hideSingles.checked;
+            _embedRenderScatter();
+          });
+          const showHulls = document.getElementById("embed-show-hulls");
+          showHulls.addEventListener("change", () => {
+            _embedState.showHulls = showHulls.checked;
+            _embedRenderScatter();
+          });
+          const fMetric = document.getElementById("embed-filter-metric");
+          const fMin = document.getElementById("embed-filter-min");
+          const fVal = document.getElementById("embed-filter-val");
+          fMetric.addEventListener("change", () => {
+            _embedState.filterMetric = fMetric.value;
+            if (!fMetric.value) {
+              fMin.disabled = true;
+              fMin.value = 0;
+              _embedState.filterMin = 0;
+              fVal.textContent = "";
+            } else {
+              let [lo, hi, step] = _EMBED_FILTER_RANGE[fMetric.value] || [0, 1, 0.01];
+              // size max from data so the slider spans the real range
+              if (fMetric.value === "cluster_size") {
