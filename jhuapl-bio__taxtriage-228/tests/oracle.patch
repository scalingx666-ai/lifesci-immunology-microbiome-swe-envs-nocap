+            .selectAll("circle.embed-hull")
+            .data(hulls)
+            .enter()
+            .append("circle")
+            .attr("class", "embed-hull")
+            .attr("cx", (d) => d.cx)
+            .attr("cy", (d) => d.cy)
+            .attr("r", (d) => d.r)
+            .attr("fill", (d) => clusterScale(d.c))
+            .attr("fill-opacity", (d) => (hlActive && String(_embedState.highlightCluster) === d.c ? 0.16 : 0.06))
+            .attr("stroke", (d) => clusterScale(d.c))
+            .attr("stroke-opacity", (d) =>
+              hlActive && _embedState.highlightCluster != null && String(_embedState.highlightCluster) !== d.c
+                ? 0.15
+                : 0.55,
+            )
+            .attr("stroke-width", (d) => (hlActive && String(_embedState.highlightCluster) === d.c ? 2.2 : 1))
+            .attr("stroke-dasharray", "4 3")
+            .style("cursor", "pointer")
+            .on("click", (ev, d) => _embedToggleClusterHighlight(d.c));
+        }
+
+        // draw reference first (behind), then query on top
+        const ordered = pts.slice().sort((a, b) => (a.set === "query" ? 1 : 0) - (b.set === "query" ? 1 : 0));
+        plot
+          .selectAll("circle.embed-pt")
+          .data(ordered)
+          .enter()
+          .append("circle")
+          .attr("class", "embed-pt")
+          .attr("cx", (p) => xScale(p._x))
+          .attr("cy", (p) => yScale(p._y))
+          .attr("r", (p) => {
+            const base = String(p.set) === "query" ? 3.2 : 2.4;
+            return hlActive && _isHl(p) ? base + 2.2 : base;
+          })
+          .attr("fill", (p) =>
+            String(p.set) === "query" ? _embedColorFor(p, _embedState.colorBy, clusterScale) : "none",
+          )
+          .attr("stroke", (p) =>
+            hlActive && _isHl(p)
+              ? "#212529"
+              : String(p.set) === "query"
+              ? "rgba(0,0,0,0.25)"
+              : _embedColorFor({ ...p, set: "query" }, _embedState.colorBy, clusterScale),
+          )
+          .attr("stroke-width", (p) => (hlActive && _isHl(p) ? 1.6 : String(p.set) === "query" ? 0.5 : 1))
