+              `${_esc(String(p.id))}` +
+              `<br>${isQuery ? "query ORF" : "reference"}` +
+              `<br>cluster ${_esc(String(p.cluster_id))}` +
+              (p._novelty ? `<br>${_esc(p._novelty)}` : "") +
+              _embedNearestLine(entry) +
