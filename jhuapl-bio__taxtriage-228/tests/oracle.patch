+          return String(p.cluster_id) === String(_embedState.highlightCluster);
+        };
+
+        const nQuery = pts.filter((p) => String(p.set) === "query").length;
+        countEl.textContent = `${nQuery} query ORFs · ${pts.length - nQuery} reference points`;
+
+        // cluster colour scale (stable across renders for this sample)
+        const clusterIds = Array.from(new Set(pts.map((p) => String(p.cluster_id)).filter((c) => c !== "-1"))).sort();
+        const clusterScale = d3.scaleOrdinal(d3.schemeCategory10.concat(d3.schemeSet3 || [])).domain(clusterIds);
+
+        const W = Math.max(420, Math.min(900, wrap.clientWidth || 720));
+        const H = 460;
+        const pad = 18;
+        const xs = d3.extent(pts, (p) => p._x);
+        const ys = d3.extent(pts, (p) => p._y);
+        const xScale = d3
+          .scaleLinear()
+          .domain(xs)
+          .range([pad, W - pad]);
+        const yScale = d3
+          .scaleLinear()
+          .domain(ys)
+          .range([H - pad, pad]);
+
+        const svg = d3
+          .select(wrap)
+          .append("svg")
+          .attr("width", W)
+          .attr("height", H)
+          .attr("viewBox", `0 0 ${W} ${H}`)
+          .style("max-width", "100%")
+          .style("background", "#fff")
+          .style("border", "1px solid #e9ecef")
+          .style("border-radius", "4px");
+
+        // Clip so zoomed/panned points stay inside the plot frame, and draw everything
+        // into a single layer <g> that the zoom behaviour transforms.
+        const _clipId = "embed-clip";
+        svg
+          .append("defs")
+          .append("clipPath")
+          .attr("id", _clipId)
+          .append("rect")
+          .attr("x", 0)
+          .attr("y", 0)
+          .attr("width", W)
+          .attr("height", H);
+        const plot = svg
+          .append("g")
+          .attr("clip-path", `url(#${_clipId})`)
+          .append("g")
+          .attr("class", "embed-zoom-layer");
+
+        let tip = document.getElementById("embed-tip");
+        if (!tip) {
+          tip = document.createElement("div");
+          tip.id = "embed-tip";
+          tip.style.cssText =
+            "position:fixed;pointer-events:none;z-index:9999;background:#212529;color:#fff;" +
+            "padding:4px 7px;border-radius:4px;font-size:11px;display:none;white-space:nowrap";
+          document.body.appendChild(tip);
+        }
+
+        // ── cluster circles (centroid + radius per real cluster) drawn behind the points ──
+        if (_embedState.showHulls) {
+          const byCluster = {};
+          pts.forEach((p) => {
+            const c = String(p.cluster_id);
+            if (c === "-1" || c === "undefined" || c === "null") return;
+            (byCluster[c] = byCluster[c] || []).push(p);
+          });
+          const hulls = Object.entries(byCluster)
+            .filter(([, ps]) => ps.length >= 2)
+            .map(([c, ps]) => {
+              const cx = d3.mean(ps, (p) => xScale(p._x));
+              const cy = d3.mean(ps, (p) => yScale(p._y));
+              const ds = ps.map((p) => Math.hypot(xScale(p._x) - cx, yScale(p._y) - cy)).sort((a, b) => a - b);
