+          });
+          fMin.addEventListener("input", () => {
+            _embedState.filterMin = +fMin.value;
+            fVal.textContent =
+              (_EMBED_FILTER_RANGE[_embedState.filterMetric] || [])[2] === 1
+                ? String(Math.round(+fMin.value))
