+    std::pair<DBGSuccinct, annot::ColumnCompressed<>>,
+    std::pair<DBGHashFast, annot::RowFlatAnnotator>
+> WalkerReferenceTypes;
+TYPED_TEST_SUITE(WalkerReference, WalkerReferenceTypes);
+
+#define CASE_TYPES \
