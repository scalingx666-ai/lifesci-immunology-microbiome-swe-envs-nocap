+#ifndef __TESTS_GRAPH_TRAVERSAL_WALKER_TEST_HELPERS_HPP__
+#define __TESTS_GRAPH_TRAVERSAL_WALKER_TEST_HELPERS_HPP__
+
+#include <algorithm>
