+
+template <class Cond>
+std::vector<std::string> blocks_where(const std::vector<size_t> &lengths, uint32_t seed,
+                                      const Cond &cond) {
+    for (uint32_t s = seed; ; ++s) {
+        auto b = clean_blocks(lengths, s);
+        if (cond(b))
+            return b;
+    }
+}
