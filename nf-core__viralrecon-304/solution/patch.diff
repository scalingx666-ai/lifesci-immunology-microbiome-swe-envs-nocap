+    ind_diff = [i for i in range(len(seq1)) if seq1[i] != seq2[i]]
+    if len(ind_diff) > 1:
+        print("There has been an issue, more than one difference between the seqs.")
+        return False
+    else:
+        return ind_diff[0]
