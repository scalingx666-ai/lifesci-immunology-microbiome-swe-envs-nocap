+
+        if not isinstance(scaled, bool):
+            raise TypeError('The scaled argument must be a bool')
+
+        self._settings.update({"opacity": {
+            "category": category,
+            "globalScale": str(global_scale),
+            "scaleVal": scaled,
+            "data": opacities
+        }})
+
+        return self
