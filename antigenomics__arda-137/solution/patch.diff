@@ -274,3 +274,106 @@ def test_the_conflict_resolution_prefers_ok_then_the_longer_germline():
     src = inspect.getsource(cdr3fix.load_anchors)
     assert 'a.status == "ok"' in src
     assert "len(a.germline_nt)" in src
+
