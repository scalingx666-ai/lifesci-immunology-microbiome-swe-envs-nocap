+def sha256(input_file):
+    """Determine SHA256 hash for file.
+    Parameters
+    ----------
+    input_file : str
+        Name of file.
+    Returns
+    -------
+    str
+        SHA256 hash.
+    """
+
+    BLOCKSIZE = 65536
+    hasher = hashlib.sha1()
+    with open(input_file, 'rb') as afile:
+        buf = afile.read(BLOCKSIZE)
+        while len(buf) > 0:
+            hasher.update(buf)
+            buf = afile.read(BLOCKSIZE)
+
+    return hasher.hexdigest()
