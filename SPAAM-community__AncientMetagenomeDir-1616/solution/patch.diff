+       width = 5,
+       height = 5
+       )
+
+
+deduplicated_dates_table <- mean_archaeological %>%
+  rbind(mean_C14) %>% 
+  select(-singlegenome_species) %>%
+  distinct()
+
+deduplicated_dates_table %>%
+    mutate(Year_BP = case_when(dating_mean > 9000 ~ "> 9000",
+                               dating_mean >= 8000 ~ "9000-8000",
+                               dating_mean >= 7000 ~ "8000-7000",
+                               dating_mean >= 6000 ~ "7000-6000",
+                               dating_mean >= 5000 ~ "6000-5000",
+                               dating_mean >= 4000 ~ "5000-4000",
+                               dating_mean >= 3000 ~ "4000-3000",
+                               dating_mean >= 2000 ~ "3000-2000",
+                               dating_mean >= 1000 ~ "2000-1000",
+                               dating_mean >= 0 ~ "1000-0",
+                               .default = "0-Present")) %>%
+    select(project_name, sample_name, uncalibrated_date, dating_mean, dating_type, Year_BP) %>%
+    distinct() %>% 
+  group_by(dating_type) %>% 
+  summarise(total = n())
+```
+
+# Statistics radiocarbon reporting
+```{r}
+radiocarbon_dates_samples <- deduplicated_dates_table %>%
+  filter(date_is_radiocarbon == "TRUE") %>%
+  mutate(Uncalibrated_reported = ifelse(uncalibrated_date == -99999, "Absent", "Present"),
+         radiocarbon_lab_code_reported = ifelse(radiocarbon_lab_code == "NR", "Absent", "Present"), 
+        radiocarbon_lab_sample_id_reported = ifelse(radiocarbon_lab_sample_id == "-99999", "Absent", "Present"),
+        delta_13c_reported = ifelse(delta_13c == -99999, "Absent", "Present"),
+        delta_15n_reported = ifelse(delta_15n == -99999, "Absent", "Present"),
+        carbon_nitrogen_ratio_reported = ifelse(carbon_nitrogen_ratio == -99999, "Absent", "Present")
+        ) %>%
+  select(sample_name, Uncalibrated_reported, radiocarbon_lab_code_reported, radiocarbon_lab_sample_id_reported, delta_13c_reported, delta_15n_reported, carbon_nitrogen_ratio_reported) %>%
+  #distinct_all() %>%
+  pivot_longer(!sample_name, names_to = "Statistic", values_to = "values") %>%
+  group_by(Statistic, values) %>%
+  summarise(total = n()) %>%
+  ggplot(aes(x= Statistic, y=total, fill = values)) +
+  geom_bar(position="fill", stat="identity") +
+  scale_x_discrete(labels=c("radiocarbon_lab_code_reported" = "Lab Code", "radiocarbon_lab_sample_id_reported" = "Lab Sample ID",
+                              "Uncalibrated_reported" = "Uncalibrated date", "delta_13c_reported" = "d13C", "delta_15n_reported" = "d15N", "carbon_nitrogen_ratio_reported" = "C:N ratio")) +
+  scale_fill_discrete(name = "Reported?", labels = c("Absent", "Present"), type = c("#00147D","#FDCC0E")) +
+  theme_classic() +
+  xlab("Metadata") + 
+  ylab("Proportion") +
+  theme(
+    axis.title = element_text(size = 12),
+    axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
+    axis.text.y = element_text(size = 9),
+    legend.position = "top", 
+    legend.text = element_text(size = 9),
+    legend.title = element_text(size = 11)
