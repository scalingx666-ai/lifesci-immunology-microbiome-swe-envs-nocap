+        delta_15n_reported = ifelse(delta_15n == -99999, "Absent", "Present"),
+        carbon_nitrogen_ratio_reported = ifelse(carbon_nitrogen_ratio == -99999, "Absent", "Present")
+        ) %>%
+  select(sample_name, Uncalibrated_reported, radiocarbon_lab_code_reported, radiocarbon_lab_sample_id_reported, delta_13c_reported, delta_15n_reported, carbon_nitrogen_ratio_reported) %>%
