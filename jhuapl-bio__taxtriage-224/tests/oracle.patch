+            it (their id/class selectors out-specify these element selectors). */
+      a:focus-visible,
+      button:focus-visible,
+      input:focus-visible,
+      select:focus-visible,
+      textarea:focus-visible,
+      [tabindex]:focus-visible {
+        outline: 2px solid var(--tt-focus);
+        outline-offset: 2px;
+        border-radius: var(--tt-radius-sm);
+      }
+      /* Tabs sit on a dark bar — use a light ring so it reads against the blue. */
+      #tabbar .tab-btn:focus-visible {
+        outline: 2px solid #fff;
+        outline-offset: -2px;
+      }
+
+      /* 2 ─ Modern, unobtrusive scrollbars (WebKit/Blink + Firefox). */
+      * {
+        scrollbar-width: thin;
+        scrollbar-color: #c2ccd6 transparent;
+      }
+      *::-webkit-scrollbar {
+        width: 10px;
+        height: 10px;
+      }
+      *::-webkit-scrollbar-thumb {
+        background: #c2ccd6;
+        border-radius: 999px;
+        border: 2px solid transparent;
+        background-clip: padding-box;
+      }
+      *::-webkit-scrollbar-thumb:hover {
+        background: #9aa7b5;
+        background-clip: padding-box;
+      }
+      *::-webkit-scrollbar-track {
+        background: transparent;
+      }
+
+      /* 3 ─ Respect reduced-motion preferences (accessibility + perf on weak
