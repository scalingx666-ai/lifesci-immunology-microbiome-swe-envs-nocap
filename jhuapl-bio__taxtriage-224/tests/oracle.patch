+          fieldLabel.textContent = u === "group" ? "Group by field" : "Label / color field";
+          if (fieldSel) fieldSel.style.opacity = u === "group" && !fields.length ? 0.5 : 1;
+        }
+
+        const pf = _cmpBuildProfiles();
+
+        if (pf.entries.length < 2) {
