-      for (size_t yy = 0; yy < ny; yy += YBF) {
-        for (size_t z = 0; z < nz; z++) {
-          size_t ymax = yy + YBF;
-          if (ymax >= ny) {
-            ymax = ny;
-          }
-          for (size_t y = yy; y < ymax; y++) {
-            size_t x = 0;
-            int c, n, s, b, t;
-            c = x + y * nx + z * nx * ny;
-#pragma omp simd
-            for (x = 1; x < nx - 1; x++) {
-              ++c;
-
-              if (y == 0 || y == (ny - 1) || z == 0 || z == (nz - 1)) {
-                continue;
-              }
-
-              n = c - nx;
-              s = c + nx;
-              b = c - nx * ny;
-              t = c + nx * ny;
-
-              real_t h2 = h / 2.0;
