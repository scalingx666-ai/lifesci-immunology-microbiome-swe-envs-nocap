+    from pathlib import Path
+
+    infile = Path("${fasta_name}")
+    outfile = Path("cleaned_fasta.faa")
+
+    with infile.open("r") as fin, outfile.open("w") as fout:
+        records = fin.read().split(">")
+
+        for record in records:
+            if not record.strip():
