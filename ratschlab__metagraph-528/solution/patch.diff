diff --git a/metagraph/CMakeLists.txt b/metagraph/CMakeLists.txt
index cb91665221..73cf10c6e8 100644
--- a/metagraph/CMakeLists.txt
+++ b/metagraph/CMakeLists.txt
@@ -300,7 +300,13 @@ target_include_directories(eigen INTERFACE external-libraries/eigen)
 target_compile_options(eigen INTERFACE -Wno-unused-but-set-variable -Wno-unused-parameter)
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${CMAKE_SOURCE_DIR})
-find_package(zstd)
+
+if(NO_ZSTD)
+  set(ZSTD_FOUND FALSE)
+else()
+  find_package(zstd)
+endif()
+
 if(ZSTD_FOUND)
   add_definitions(-D_SUPPORT_ZSTD)
 else()
@@ -425,9 +431,9 @@ set_target_properties(metagraph PROPERTIES OUTPUT_NAME "metagraph_${CMAKE_DBG_AL
 set(METALIBS ${METALIBS}
   -lKMC
   -lhts
-  Boost::iostreams
   zlib
   deflate
+  Boost::iostreams
   -lsdsl
   jsoncpp_lib
   progress_bar
@@ -439,7 +445,6 @@ set(METALIBS ${METALIBS}
   ips4o
   caches
   eigen
-  zstd::zstd
 )
 if(APPLE)
   set(METALIBS ${METALIBS} ${OpenMP_CXX_LIBRARIES})
@@ -448,6 +453,10 @@ if (CMAKE_CXX_COMPILER_ID MATCHES "GNU" OR NOT ${CMAKE_SYSTEM_NAME} MATCHES "Dar
   set(METALIBS ${METALIBS} -latomic)
 endif()
 
+if(ZSTD_FOUND)
+  set(METALIBS ${METALIBS} zstd::zstd)
+endif()
+
 if(BUILD_STATIC AND NOT APPLE)
   set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -static -static-libstdc++ -static-libgcc")
   find_package(OpenSSL REQUIRED)
diff --git a/metagraph/src/seq_io/sequence_io.cpp b/metagraph/src/seq_io/sequence_io.cpp
index 911b34c231..6b92d44d2a 100644
--- a/metagraph/src/seq_io/sequence_io.cpp
+++ b/metagraph/src/seq_io/sequence_io.cpp
@@ -1,7 +1,6 @@
 #include "sequence_io.hpp"
 
 #include <algorithm>
-#include <iostream>
 #include <thread>
 #include <sstream>
 
@@ -114,14 +113,15 @@ ExtendedFastaWriter<T>::ExtendedFastaWriter(const std::string &filebase,
     static_assert(sizeof(kmer_length_) == 4);
 
     fasta_fname_ = utils::remove_suffix(filebase, ".zst");
-#if _SUPPORT_ZSTD
     bool zstd = (fasta_fname_.size() < filebase.size());
-#else
+
+#if ! _SUPPORT_ZSTD
     if (zstd) {
         std::cerr << "ERROR: zstd not supported. Recompile with zstd support." << std::endl;
         exit(1);
     }
 #endif
+
     std::string comp_type = zstd ? ".zst" : ".gz";
 
     fasta_fname_ = utils::remove_suffix(filebase, comp_type, ".fasta") + ".fasta" + comp_type;
