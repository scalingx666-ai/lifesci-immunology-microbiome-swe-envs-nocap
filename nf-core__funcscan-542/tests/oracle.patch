+@ARTICLE{Janak2026-ek,
+  title     = "When probiotics turn deadly: a case of Lacticaseibacillus
+               rhamnosus sepsis in a burn patient",
+  author    = "Janák, David and Bakalář, Bohumil and Fridrichová, Marta and
